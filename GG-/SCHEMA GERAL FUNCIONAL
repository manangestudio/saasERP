07 | FUNCAO: public.fn_admin_ambassador_audit | ASSINATURA: p_ambassador_id text, p_limit integer | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: s | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_ambassador_audit(p_ambassador_id text DEFAULT NULL::text, p_limit integer DEFAULT 200)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    RETURN COALESCE((SELECT jsonb_agg(to_jsonb(x)) FROM (
        SELECT l.id, l.action, l.ambassador_id, l.store_ref_id, l.actor_id, l.actor_role, l.reason, l.details, l.created_at
          FROM public.ambassador_audit_log l
         WHERE p_ambassador_id IS NULL OR l.ambassador_id = p_ambassador_id
         ORDER BY l.created_at DESC LIMIT LEAST(GREATEST(COALESCE(p_limit, 200), 1), 1000)) x), '[]'::JSONB);
END; $function$

07 | FUNCAO: public.fn_admin_block_ambassador | ASSINATURA: p_ambassador_id text, p_status text, p_reason text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_block_ambassador(p_ambassador_id text, p_status text, p_reason text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE v_status TEXT := UPPER(TRIM(COALESCE(p_status, ''))); v_old TEXT;
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    IF v_status <> 'ATIVO' AND NULLIF(TRIM(COALESCE(p_reason, '')), '') IS NULL THEN
        RAISE EXCEPTION 'Indique o motivo do bloqueio.';
    END IF;
    SELECT COALESCE(status, 'ATIVO') INTO v_old FROM public.ambassadors WHERE id = p_ambassador_id AND deleted_at IS NULL;
    IF v_old IS NULL THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;
    PERFORM public.fn_admin_set_ambassador_status(p_ambassador_id, v_status);
    UPDATE public.ambassadors
       SET block_reason = CASE WHEN v_status = 'ATIVO' THEN NULL ELSE TRIM(p_reason) END,
           blocked_by_role = CASE WHEN v_status = 'ATIVO' THEN NULL ELSE 'SUPERADMIN' END
     WHERE id = p_ambassador_id;
    PERFORM public.fn_amb_audit(CASE WHEN v_status = 'ATIVO' THEN 'UNBLOCKED' ELSE 'BLOCKED' END, p_ambassador_id, NULL, p_reason,
        jsonb_build_object('from', v_old, 'to', v_status));
    RETURN jsonb_build_object('success', TRUE, 'status', v_status);
END; $function$

07 | FUNCAO: public.fn_admin_create_ambassador_login | ASSINATURA: p_ambassador_id text, p_email text, p_password text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_create_ambassador_login(p_ambassador_id text, p_email text, p_password text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'extensions', 'auth', 'pg_temp'
AS $function$
DECLARE
    v_amb public.ambassadors%ROWTYPE;
    v_uid UUID;
BEGIN
    IF public.get_auth_user_role() IS DISTINCT FROM 'SUPERADMIN' THEN
        RAISE EXCEPTION 'Apenas o Super Admin pode criar o acesso de um embaixador.';
    END IF;

    SELECT * INTO v_amb FROM public.ambassadors WHERE id = p_ambassador_id;
    IF v_amb.id IS NULL THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;
    IF v_amb.user_id IS NOT NULL THEN RAISE EXCEPTION 'Este embaixador já tem acesso criado.'; END IF;

    v_uid := public.fn_internal_create_store_user(p_email, p_password, v_amb.name, 'EMBAIXADOR', NULL);

    UPDATE public.ambassadors SET user_id = v_uid WHERE id = v_amb.id;

    RETURN jsonb_build_object('success', TRUE, 'user_id', v_uid, 'email', LOWER(TRIM(p_email)));
END;
$function$

07 | FUNCAO: public.fn_admin_create_ambassador_profile | ASSINATURA: p_kind text, p_name text, p_phone text, p_whatsapp text, p_email text, p_pix_mpesa text, p_language text, p_currency text, p_commission_rate numeric, p_indirect_rate numeric, p_effective_from date, p_parent_id text, p_country text, p_province text, p_district text, p_city text, p_neighborhood text, p_geo_description text, p_login_email text, p_login_password text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_create_ambassador_profile(p_kind text, p_name text, p_phone text, p_whatsapp text, p_email text, p_pix_mpesa text, p_language text, p_currency text, p_commission_rate numeric, p_indirect_rate numeric, p_effective_from date, p_parent_id text, p_country text, p_province text, p_district text, p_city text, p_neighborhood text, p_geo_description text, p_login_email text DEFAULT NULL::text, p_login_password text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'extensions', 'auth', 'pg_temp'
AS $function$
DECLARE
    v_kind TEXT := UPPER(TRIM(COALESCE(p_kind, '')));
    v_super BOOLEAN; v_id TEXT; v_code TEXT; v_uid UUID; v_par public.ambassadors%ROWTYPE;
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    IF v_kind NOT IN ('EMBAIXADOR', 'SUPER_EMBAIXADOR') THEN RAISE EXCEPTION 'Perfil inválido.'; END IF;
    v_super := (v_kind = 'SUPER_EMBAIXADOR');
    IF NULLIF(TRIM(COALESCE(p_name, '')), '') IS NULL THEN RAISE EXCEPTION 'Nome é obrigatório.'; END IF;
    IF NULLIF(TRIM(COALESCE(p_phone, '')), '') IS NULL THEN RAISE EXCEPTION 'Telefone é obrigatório.'; END IF;
    IF p_language IS NULL OR NOT public.fn_valid_language(p_language) THEN RAISE EXCEPTION 'Seleccione o idioma (obrigatório).'; END IF;
    IF p_currency IS NULL OR NOT public.fn_valid_currency(p_currency) THEN RAISE EXCEPTION 'Seleccione a moeda (obrigatório).'; END IF;
    IF p_commission_rate IS NULL OR p_commission_rate < 0 OR p_commission_rate > 100 THEN RAISE EXCEPTION 'Comissão inválida (0 a 100).'; END IF;
    IF COALESCE(p_indirect_rate, 0) < 0 OR COALESCE(p_indirect_rate, 0) > 100 THEN RAISE EXCEPTION 'Comissão indirecta inválida (0 a 100).'; END IF;
    IF COALESCE(p_indirect_rate, 0) > 0 AND NOT v_super THEN RAISE EXCEPTION 'Só Super Embaixadores têm comissão indirecta.'; END IF;
    IF v_super AND NULLIF(TRIM(COALESCE(p_parent_id, '')), '') IS NOT NULL THEN RAISE EXCEPTION 'Um Super Embaixador não pode ter Super Embaixador acima.'; END IF;
    IF NULLIF(TRIM(COALESCE(p_parent_id, '')), '') IS NOT NULL THEN
        SELECT * INTO v_par FROM public.ambassadors WHERE id = p_parent_id AND deleted_at IS NULL;
        IF v_par.id IS NULL OR NOT COALESCE(v_par.is_super, FALSE) OR COALESCE(v_par.status, 'ATIVO') <> 'ATIVO' THEN
            RAISE EXCEPTION 'O Super Embaixador escolhido não existe, não está activo ou não é Super Embaixador.';
        END IF;
    END IF;
    IF (NULLIF(TRIM(COALESCE(p_login_email, '')), '') IS NULL) <> (NULLIF(p_login_password, '') IS NULL) THEN
        RAISE EXCEPTION 'Para criar o acesso, indique email e senha.';
    END IF;

    v_id := 'amb-' || SUBSTR(REPLACE(gen_random_uuid()::TEXT, '-', ''), 1, 16);
    v_code := public.fn_amb_code(p_name);

    INSERT INTO public.ambassadors (id, name, phone, whatsapp, email, pix_mpesa, referral_code, commission_rate, indirect_commission_rate,
                                    is_super, parent_ambassador_id, status, active, language, currency, effective_from,
                                    geo_country, geo_province, geo_district, geo_city, geo_neighborhood, geo_description)
    VALUES (v_id, TRIM(p_name), TRIM(p_phone), NULLIF(TRIM(COALESCE(p_whatsapp, '')), ''), NULLIF(TRIM(COALESCE(p_email, '')), ''),
            COALESCE(NULLIF(TRIM(COALESCE(p_pix_mpesa, '')), ''), 'M-Pesa ' || TRIM(p_phone)), v_code, p_commission_rate,
            CASE WHEN v_super THEN COALESCE(p_indirect_rate, 0) ELSE 0 END,
            v_super, NULLIF(TRIM(COALESCE(p_parent_id, '')), ''), 'ATIVO', TRUE, p_language, p_currency, COALESCE(p_effective_from, CURRENT_DATE),
            NULLIF(TRIM(COALESCE(p_country, '')), ''), NULLIF(TRIM(COALESCE(p_province, '')), ''), NULLIF(TRIM(COALESCE(p_district, '')), ''),
            NULLIF(TRIM(COALESCE(p_city, '')), ''), NULLIF(TRIM(COALESCE(p_neighborhood, '')), ''), NULLIF(TRIM(COALESCE(p_geo_description, '')), ''));

    IF NULLIF(TRIM(COALESCE(p_login_email, '')), '') IS NOT NULL THEN
        v_uid := public.fn_internal_create_store_user(p_login_email, p_login_password, TRIM(p_name), 'EMBAIXADOR', NULL);
        UPDATE public.ambassadors SET user_id = v_uid WHERE id = v_id;
    END IF;

    INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value)
    VALUES (v_id, 'commission_rate', NULL, p_commission_rate::TEXT);
    PERFORM public.fn_amb_audit('CREATED', v_id, NULL, NULL,
        jsonb_build_object('kind', v_kind, 'language', p_language, 'currency', p_currency, 'commission', p_commission_rate,
                           'indirect', COALESCE(p_indirect_rate, 0), 'parent', p_parent_id, 'login_created', v_uid IS NOT NULL));
    RETURN jsonb_build_object('success', TRUE, 'ambassador_id', v_id, 'referral_code', v_code, 'user_id', v_uid);
END; $function$

07 | FUNCAO: public.fn_admin_demote_ambassador | ASSINATURA: p_ambassador_id text, p_reason text, p_network_target_id text, p_new_parent_id text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_demote_ambassador(p_ambassador_id text, p_reason text, p_network_target_id text DEFAULT NULL::text, p_new_parent_id text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE a public.ambassadors%ROWTYPE; tgt public.ambassadors%ROWTYPE; np public.ambassadors%ROWTYPE; c RECORD; v_n INT := 0;
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    IF NULLIF(TRIM(COALESCE(p_reason, '')), '') IS NULL THEN RAISE EXCEPTION 'Indique o motivo.'; END IF;
    SELECT * INTO a FROM public.ambassadors WHERE id = p_ambassador_id AND deleted_at IS NULL FOR UPDATE;
    IF a.id IS NULL THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;
    IF NOT COALESCE(a.is_super, FALSE) THEN RAISE EXCEPTION 'Não é Super Embaixador.'; END IF;

    IF EXISTS (SELECT 1 FROM public.ambassadors WHERE parent_ambassador_id = a.id AND deleted_at IS NULL) THEN
        SELECT * INTO tgt FROM public.ambassadors WHERE id = p_network_target_id AND deleted_at IS NULL;
        IF tgt.id IS NULL OR tgt.id = a.id OR NOT COALESCE(tgt.is_super, FALSE) OR COALESCE(tgt.status, 'ATIVO') <> 'ATIVO' THEN
            RAISE EXCEPTION 'Tem embaixadores na rede: indique um Super Embaixador activo de destino.';
        END IF;
        FOR c IN SELECT id FROM public.ambassadors WHERE parent_ambassador_id = a.id AND deleted_at IS NULL FOR UPDATE LOOP
            UPDATE public.ambassadors SET parent_ambassador_id = tgt.id WHERE id = c.id;
            INSERT INTO public.ambassador_transfers(kind, subject_id, from_id, to_id, reason, effective_date, details)
            VALUES ('AMBASSADOR', c.id, a.id, tgt.id, 'Despromoção do Super Embaixador: ' || TRIM(p_reason), CURRENT_DATE, jsonb_build_object('operation', 'DEMOTE'));
            INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value) VALUES (c.id, 'parent_ambassador_id', a.id, tgt.id);
            v_n := v_n + 1;
        END LOOP;
    END IF;

    IF NULLIF(TRIM(COALESCE(p_new_parent_id, '')), '') IS NOT NULL THEN
        SELECT * INTO np FROM public.ambassadors WHERE id = p_new_parent_id AND deleted_at IS NULL;
        IF np.id IS NULL OR np.id = a.id OR NOT COALESCE(np.is_super, FALSE) OR COALESCE(np.status, 'ATIVO') <> 'ATIVO' THEN
            RAISE EXCEPTION 'O novo Super Embaixador responsável é inválido.';
        END IF;
    END IF;

    UPDATE public.ambassadors SET is_super = FALSE, indirect_commission_rate = 0, parent_ambassador_id = NULLIF(TRIM(COALESCE(p_new_parent_id, '')), '') WHERE id = a.id;
    INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value) VALUES (a.id, 'is_super', 'true', 'false');
    IF COALESCE(a.indirect_commission_rate, 0) <> 0 THEN
        INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value) VALUES (a.id, 'indirect_commission_rate', a.indirect_commission_rate::TEXT, '0');
    END IF;
    PERFORM public.fn_amb_audit('DEMOTED', a.id, NULL, p_reason, jsonb_build_object('network_moved_to', p_network_target_id, 'ambassadors_moved', v_n, 'new_parent', p_new_parent_id));
    RETURN jsonb_build_object('success', TRUE, 'ambassadors_moved', v_n);
END; $function$

07 | FUNCAO: public.fn_admin_list_ambassadors | ASSINATURA: p_include_deleted boolean | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_list_ambassadors(p_include_deleted boolean DEFAULT false)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    PERFORM public.fn_apply_due_rate_changes();
    RETURN COALESCE((SELECT jsonb_agg(jsonb_build_object(
        'id', a.id, 'name', a.name, 'phone', a.phone, 'whatsapp', a.whatsapp, 'email', a.email,
        'status', COALESCE(a.status, CASE WHEN a.active THEN 'ATIVO' ELSE 'DESATIVADO' END),
        'block_reason', a.block_reason, 'is_super', COALESCE(a.is_super, FALSE), 'parent_ambassador_id', a.parent_ambassador_id,
        'commission_rate', COALESCE(a.commission_rate, 0), 'indirect_commission_rate', COALESCE(a.indirect_commission_rate, 0),
        'language', a.language, 'currency', a.currency, 'has_login', a.user_id IS NOT NULL, 'deleted', a.deleted_at IS NOT NULL,
        'geo_country', a.geo_country, 'geo_province', a.geo_province, 'geo_district', a.geo_district, 'geo_city', a.geo_city,
        'geo_neighborhood', a.geo_neighborhood, 'geo_description', a.geo_description, 'referral_code', a.referral_code,
        'stores', (SELECT COUNT(*) FROM public.ambassador_referred_stores r WHERE r.ambassador_id = a.id),
        'pending_rates', (SELECT COUNT(*) FROM public.ambassador_rate_schedule s WHERE s.ambassador_id = a.id AND s.applied_at IS NULL)
    ) ORDER BY a.created_at) FROM public.ambassadors a WHERE p_include_deleted OR a.deleted_at IS NULL), '[]'::JSONB);
END; $function$

07 | FUNCAO: public.fn_admin_network_report | ASSINATURA: p_from date, p_to date | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: s | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_network_report(p_from date DEFAULT NULL::date, p_to date DEFAULT NULL::date)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE v_out JSONB;
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;

    WITH st AS (
        SELECT r.id AS ref_id, r.ambassador_id, r.name, r.owner_name, r.phone, r.city, r.created_at,
               r.last_payment_date, s.data_fim_teste,
               COALESCE(s.valor_mensalidade, r.monthly_fee, 0) AS fee,
               CASE WHEN s.id IS NULL THEN 'SEM_LOJA'
                    WHEN s.acesso_ativo = FALSE THEN 'BLOQUEADA'
                    WHEN s.data_fim_teste < CURRENT_DATE THEN 'EXPIRADA'
                    WHEN r.last_payment_date IS NULL THEN 'EM_TESTE'
                    ELSE 'ATIVA' END AS status,
               (s.data_fim_teste - CURRENT_DATE) AS days_remaining
          FROM public.ambassador_referred_stores r
          LEFT JOIN public.stores s ON s.id = COALESCE(r.store_id, r.id)
    ),
    pay AS (
        SELECT * FROM public.ambassador_commission_payments p
         WHERE (p_from IS NULL OR p.paid_at::DATE >= p_from)
           AND (p_to IS NULL OR p.paid_at::DATE <= p_to)
    )
    SELECT jsonb_build_object(
        'generated_at', NOW(),
        'period', jsonb_build_object('from', p_from, 'to', p_to),
        'ambassadors', COALESCE((SELECT jsonb_agg(to_jsonb(x)) FROM (
            SELECT a.id, a.name, a.phone,
                   COALESCE(a.status, CASE WHEN a.active THEN 'ATIVO' ELSE 'DESATIVADO' END) AS status,
                   COALESCE(a.is_super, FALSE) AS is_super, a.parent_ambassador_id,
                   COALESCE(a.commission_rate, 0) AS commission_rate,
                   COALESCE(a.indirect_commission_rate, 0) AS indirect_commission_rate,
                   a.created_at,
                   COALESCE(a.pending_commissions, 0) AS pending_commissions,
                   (SELECT COALESCE(SUM(po.amount), 0) FROM public.ambassador_payouts po WHERE po.ambassador_id = a.id) AS paid_commissions,
                   (SELECT MAX(p.paid_at) FROM public.ambassador_commission_payments p WHERE p.ambassador_id = a.id AND p.kind = 'DIRECT') AS last_payment_at,
                   (SELECT MAX(r.created_at) FROM public.ambassador_referred_stores r WHERE r.ambassador_id = a.id) AS last_store_at
              FROM public.ambassadors a ORDER BY a.created_at) x), '[]'::JSONB),
        'stores', COALESCE((SELECT jsonb_agg(to_jsonb(y)) FROM (
            SELECT st.ref_id AS id, st.name, st.owner_name, st.phone, st.city, st.created_at, st.ambassador_id,
                   st.status, st.fee AS monthly_fee, st.data_fim_teste AS subscription_end, st.days_remaining,
                   st.last_payment_date,
                   COALESCE((SELECT SUM(p.payment_amount) FROM pay p WHERE p.referred_store_id = st.ref_id AND p.kind = 'DIRECT'), 0) AS received,
                   COALESCE((SELECT SUM(p.commission_amount) FROM pay p WHERE p.referred_store_id = st.ref_id AND p.kind = 'DIRECT'), 0) AS commission,
                   CASE WHEN st.status = 'EXPIRADA'
                        THEN st.fee * GREATEST(1, CEIL((CURRENT_DATE - st.data_fim_teste) / 30.0)) ELSE 0 END AS overdue_amount,
                   CASE WHEN st.status = 'EXPIRADA' THEN CURRENT_DATE - st.data_fim_teste END AS days_overdue
              FROM st ORDER BY st.created_at DESC) y), '[]'::JSONB),
        'monthly', COALESCE((SELECT jsonb_agg(to_jsonb(m)) FROM (
            SELECT p.ambassador_id, to_char(p.paid_at, 'YYYY-MM') AS month,
                   SUM(p.payment_amount) FILTER (WHERE p.kind = 'DIRECT') AS received,
                   SUM(p.commission_amount) FILTER (WHERE p.kind = 'DIRECT') AS commission_direct,
                   SUM(p.commission_amount) FILTER (WHERE p.kind = 'INDIRECT') AS commission_indirect
              FROM pay p GROUP BY p.ambassador_id, to_char(p.paid_at, 'YYYY-MM') ORDER BY 2) m), '[]'::JSONB),
        'recent_payments', COALESCE((SELECT jsonb_agg(to_jsonb(z)) FROM (
            SELECT p.id, p.ambassador_id, p.referred_store_id, p.store_id, p.store_name, p.paid_at,
                   p.payment_amount, p.commission_rate, p.commission_amount, p.kind, p.source_ambassador_id
              FROM pay p ORDER BY p.paid_at DESC LIMIT 500) z), '[]'::JSONB),
        'payouts', COALESCE((SELECT jsonb_agg(to_jsonb(q)) FROM (
            SELECT po.id, po.ambassador_id, po.amount, po.method, po.receipt, po.status, po.created_at
              FROM public.ambassador_payouts po ORDER BY po.created_at DESC LIMIT 300) q), '[]'::JSONB),
        'rate_audit', COALESCE((SELECT jsonb_agg(to_jsonb(au)) FROM (
            SELECT id, ambassador_id, field, old_value, new_value, changed_by, changed_at
              FROM public.ambassador_rate_audit ORDER BY changed_at DESC LIMIT 300) au), '[]'::JSONB)
    ) INTO v_out;

    RETURN v_out;
END;
$function$

07 | FUNCAO: public.fn_admin_pay_ambassador_commission | ASSINATURA: p_ambassador_id text, p_amount numeric, p_method text, p_receipt text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_pay_ambassador_commission(p_ambassador_id text, p_amount numeric, p_method text, p_receipt text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
    v_role TEXT;
    v_ambassador public.ambassadors%ROWTYPE;
    v_amount NUMERIC;
    v_payout_id TEXT;
BEGIN

    -- =====================================================
    -- SUPERADMIN
    -- =====================================================

    v_role := get_auth_user_role();

    IF v_role <> 'SUPERADMIN' THEN
        RAISE EXCEPTION '%',
            'Apenas o Superadmin pode liquidar comissões.';
    END IF;


    -- =====================================================
    -- VALORES
    -- =====================================================

    v_amount := COALESCE(p_amount, 0);

    IF v_amount <= 0 THEN
        RAISE EXCEPTION '%',
            'O valor da comissão deve ser maior que zero.';
    END IF;


    -- =====================================================
    -- BLOQUEAR REGISTRO DO EMBAIXADOR
    -- =====================================================

    SELECT *
    INTO v_ambassador
    FROM public.ambassadors
    WHERE id = p_ambassador_id
    FOR UPDATE;

    IF v_ambassador.id IS NULL THEN
        RAISE EXCEPTION '%',
            'Embaixador não encontrado.';
    END IF;


    -- =====================================================
    -- NÃO PERMITIR PAGAMENTO ACIMA DO PENDENTE
    -- =====================================================

    IF v_amount > COALESCE(v_ambassador.pending_commissions, 0) THEN
        RAISE EXCEPTION '%',
            'O valor informado é superior à comissão pendente.';
    END IF;


    -- =====================================================
    -- GERAR ID DO PAGAMENTO
    -- =====================================================

    v_payout_id :=
        'LIQ-' ||
        substring(
            replace(gen_random_uuid()::text, '-', '')
            FROM 1 FOR 20
        );


    -- =====================================================
    -- REGISTRAR PAGAMENTO
    -- =====================================================

    INSERT INTO public.ambassador_payouts (
        id,
        ambassador_id,
        amount,
        method,
        receipt,
        status
    )
    VALUES (
        v_payout_id,
        p_ambassador_id,
        v_amount,
        NULLIF(TRIM(p_method), ''),
        NULLIF(TRIM(p_receipt), ''),
        'LIQUIDADO'
    );


    -- =====================================================
    -- ATUALIZAR SALDOS
    -- =====================================================

    UPDATE public.ambassadors
    SET
        pending_commissions =
            GREATEST(
                COALESCE(pending_commissions, 0) - v_amount,
                0
            ),
        total_earned =
            COALESCE(total_earned, 0) + v_amount
    WHERE id = p_ambassador_id;


    RETURN jsonb_build_object(
        'success', TRUE,
        'payout_id', v_payout_id,
        'ambassador_id', p_ambassador_id,
        'amount', v_amount,
        'status', 'LIQUIDADO',
        'message', 'Comissão liquidada com sucesso.'
    );

END;
$function$

07 | FUNCAO: public.fn_admin_preview_ambassador_change | ASSINATURA: p_ambassador_id text, p_action text, p_target_id text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: s | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_preview_ambassador_change(p_ambassador_id text, p_action text, p_target_id text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    a public.ambassadors%ROWTYPE; par public.ambassadors%ROWTYPE; tgt public.ambassadors%ROWTYPE;
    v_act TEXT := UPPER(TRIM(COALESCE(p_action, '')));
    v_children JSONB; v_stores JSONB; v_errors JSONB := '[]'::JSONB; v_warn JSONB := '[]'::JSONB;
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    SELECT * INTO a FROM public.ambassadors WHERE id = p_ambassador_id AND deleted_at IS NULL;
    IF a.id IS NULL THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;
    IF a.parent_ambassador_id IS NOT NULL THEN SELECT * INTO par FROM public.ambassadors WHERE id = a.parent_ambassador_id; END IF;
    IF p_target_id IS NOT NULL THEN SELECT * INTO tgt FROM public.ambassadors WHERE id = p_target_id AND deleted_at IS NULL; END IF;

    SELECT COALESCE(jsonb_agg(jsonb_build_object('id', c.id, 'name', c.name, 'status', COALESCE(c.status, 'ATIVO'),
             'stores', (SELECT COUNT(*) FROM public.ambassador_referred_stores r WHERE r.ambassador_id = c.id))), '[]'::JSONB)
      INTO v_children FROM public.ambassadors c WHERE c.parent_ambassador_id = a.id AND c.deleted_at IS NULL;
    SELECT COALESCE(jsonb_agg(jsonb_build_object('id', r.id, 'name', r.name, 'monthly_fee', r.monthly_fee, 'commission_rate', r.commission_rate)), '[]'::JSONB)
      INTO v_stores FROM public.ambassador_referred_stores r WHERE r.ambassador_id = a.id;

    IF v_act = 'PROMOTE' THEN
        IF COALESCE(a.is_super, FALSE) THEN v_errors := v_errors || to_jsonb('Já é Super Embaixador.'::TEXT); END IF;
        IF a.parent_ambassador_id IS NOT NULL THEN
            v_warn := v_warn || to_jsonb(('Está na rede de «' || par.name || '». Ao promover sai dessa rede (fica registado no histórico). As lojas e comissões antigas não mudam.')::TEXT);
        END IF;
    ELSIF v_act = 'DEMOTE' THEN
        IF NOT COALESCE(a.is_super, FALSE) THEN v_errors := v_errors || to_jsonb('Não é Super Embaixador.'::TEXT); END IF;
        IF jsonb_array_length(v_children) > 0 AND tgt.id IS NULL THEN
            v_errors := v_errors || to_jsonb('Tem embaixadores na rede: escolha o Super Embaixador de destino para os receber.'::TEXT);
        END IF;
        IF tgt.id IS NOT NULL AND (NOT COALESCE(tgt.is_super, FALSE) OR tgt.id = a.id) THEN
            v_errors := v_errors || to_jsonb('O destino tem de ser outro Super Embaixador.'::TEXT);
        END IF;
        v_warn := v_warn || to_jsonb('A comissão indirecta passa a 0. Os pagamentos e comissões já registados mantêm-se.'::TEXT);
    ELSIF v_act = 'TRANSFER' THEN
        IF COALESCE(a.is_super, FALSE) THEN v_errors := v_errors || to_jsonb('Um Super Embaixador não é transferido: use a despromoção.'::TEXT); END IF;
        IF tgt.id IS NULL OR NOT COALESCE(tgt.is_super, FALSE) OR COALESCE(tgt.status, 'ATIVO') <> 'ATIVO' THEN
            v_errors := v_errors || to_jsonb('Destino inválido: tem de ser um Super Embaixador activo.'::TEXT);
        END IF;
        IF tgt.id IS NOT NULL AND tgt.id = a.parent_ambassador_id THEN v_errors := v_errors || to_jsonb('Já pertence a este Super Embaixador.'::TEXT); END IF;
        v_warn := v_warn || to_jsonb('A comissão indirecta dos pagamentos futuros vai para o novo Super Embaixador; os pagamentos já registados ficam com o anterior.'::TEXT);
    ELSIF v_act = 'DELETE' THEN
        IF (jsonb_array_length(v_children) > 0 OR jsonb_array_length(v_stores) > 0) AND tgt.id IS NULL THEN
            v_errors := v_errors || to_jsonb('Tem embaixadores/lojas vinculados: escolha o destino que os recebe.'::TEXT);
        END IF;
        v_warn := v_warn || to_jsonb('Eliminação lógica: nada é apagado; lojas, pagamentos e comissões mantêm-se no histórico.'::TEXT);
    ELSE
        RAISE EXCEPTION 'Acção inválida.';
    END IF;

    RETURN jsonb_build_object('ambassador', jsonb_build_object('id', a.id, 'name', a.name, 'is_super', COALESCE(a.is_super, FALSE), 'status', COALESCE(a.status, 'ATIVO'),
                'pending_commissions', COALESCE(a.pending_commissions, 0)),
        'current_parent', CASE WHEN par.id IS NULL THEN NULL ELSE jsonb_build_object('id', par.id, 'name', par.name, 'phone', par.phone) END,
        'target', CASE WHEN tgt.id IS NULL THEN NULL ELSE jsonb_build_object('id', tgt.id, 'name', tgt.name, 'is_super', COALESCE(tgt.is_super, FALSE)) END,
        'network_ambassadors', v_children, 'direct_stores', v_stores, 'errors', v_errors, 'warnings', v_warn, 'can_proceed', jsonb_array_length(v_errors) = 0);
END; $function$

07 | FUNCAO: public.fn_admin_preview_store_transfer | ASSINATURA: p_ref_store_id text, p_target_id text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: s | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_preview_store_transfer(p_ref_store_id text, p_target_id text)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE r public.ambassador_referred_stores%ROWTYPE; o public.ambassadors%ROWTYPE; t public.ambassadors%ROWTYPE;
        v_errors JSONB := '[]'::JSONB; v_hist INT; v_pend NUMERIC;
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    SELECT * INTO r FROM public.ambassador_referred_stores WHERE id = p_ref_store_id;
    IF r.id IS NULL THEN RAISE EXCEPTION 'Loja indicada não encontrada.'; END IF;
    SELECT * INTO o FROM public.ambassadors WHERE id = r.ambassador_id;
    SELECT * INTO t FROM public.ambassadors WHERE id = p_target_id AND deleted_at IS NULL;
    IF t.id IS NULL OR COALESCE(t.status, 'ATIVO') <> 'ATIVO' THEN v_errors := v_errors || to_jsonb('Destino inválido: tem de ser um embaixador activo.'::TEXT); END IF;
    IF t.id IS NOT NULL AND t.id = r.ambassador_id THEN v_errors := v_errors || to_jsonb('A loja já pertence a este embaixador.'::TEXT); END IF;
    SELECT COUNT(*), COALESCE(SUM(commission_amount), 0) INTO v_hist, v_pend FROM public.ambassador_commission_payments WHERE referred_store_id = r.id;
    RETURN jsonb_build_object('store', jsonb_build_object('id', r.id, 'name', r.name, 'monthly_fee', r.monthly_fee, 'commission_rate', r.commission_rate),
        'from', jsonb_build_object('id', o.id, 'name', o.name, 'is_super', COALESCE(o.is_super, FALSE), 'parent_id', o.parent_ambassador_id),
        'to', CASE WHEN t.id IS NULL THEN NULL ELSE jsonb_build_object('id', t.id, 'name', t.name, 'is_super', COALESCE(t.is_super, FALSE), 'parent_id', t.parent_ambassador_id, 'commission_rate', t.commission_rate) END,
        'historical_payments', v_hist, 'historical_commission', v_pend,
        'warnings', jsonb_build_array('Os pagamentos e comissões já registados ficam com o embaixador anterior.',
                                       'Os pagamentos futuros passam a gerar comissão para o novo embaixador (e para o Super Embaixador dele, se existir).'),
        'errors', v_errors, 'can_proceed', jsonb_array_length(v_errors) = 0);
END; $function$

07 | FUNCAO: public.fn_admin_promote_ambassador | ASSINATURA: p_ambassador_id text, p_reason text, p_indirect_rate numeric, p_effective_from date | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_promote_ambassador(p_ambassador_id text, p_reason text, p_indirect_rate numeric DEFAULT 0, p_effective_from date DEFAULT NULL::date)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE a public.ambassadors%ROWTYPE; v_from DATE := COALESCE(p_effective_from, CURRENT_DATE);
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    IF NULLIF(TRIM(COALESCE(p_reason, '')), '') IS NULL THEN RAISE EXCEPTION 'Indique o motivo.'; END IF;
    IF COALESCE(p_indirect_rate, 0) < 0 OR COALESCE(p_indirect_rate, 0) > 100 THEN RAISE EXCEPTION 'Comissão indirecta inválida (0 a 100).'; END IF;
    SELECT * INTO a FROM public.ambassadors WHERE id = p_ambassador_id AND deleted_at IS NULL FOR UPDATE;
    IF a.id IS NULL THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;
    IF COALESCE(a.is_super, FALSE) THEN RAISE EXCEPTION 'Já é Super Embaixador.'; END IF;
    IF COALESCE(a.status, 'ATIVO') <> 'ATIVO' THEN RAISE EXCEPTION 'Só se promove um embaixador activo.'; END IF;

    IF a.parent_ambassador_id IS NOT NULL THEN
        INSERT INTO public.ambassador_transfers(kind, subject_id, from_id, to_id, reason, effective_date, details)
        VALUES ('AMBASSADOR', a.id, a.parent_ambassador_id, NULL, 'Promoção a Super Embaixador: ' || TRIM(p_reason), v_from, jsonb_build_object('operation', 'PROMOTE'));
    END IF;
    UPDATE public.ambassadors
       SET is_super = TRUE, parent_ambassador_id = NULL, effective_from = v_from,
           indirect_commission_rate = COALESCE(p_indirect_rate, 0)
     WHERE id = a.id;
    INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value) VALUES (a.id, 'is_super', 'false', 'true');
    IF a.parent_ambassador_id IS NOT NULL THEN
        INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value) VALUES (a.id, 'parent_ambassador_id', a.parent_ambassador_id, NULL);
    END IF;
    PERFORM public.fn_amb_audit('PROMOTED', a.id, NULL, p_reason, jsonb_build_object('previous_parent', a.parent_ambassador_id, 'indirect_rate', COALESCE(p_indirect_rate, 0), 'effective_from', v_from));
    RETURN jsonb_build_object('success', TRUE);
END; $function$

07 | FUNCAO: public.fn_admin_save_fee_package | ASSINATURA: p_id text, p_name text, p_fee numeric, p_active boolean | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_save_fee_package(p_id text, p_name text, p_fee numeric, p_active boolean DEFAULT true)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE v_id TEXT := COALESCE(NULLIF(TRIM(p_id), ''), 'pkg-' || SUBSTR(REPLACE(gen_random_uuid()::TEXT, '-', ''), 1, 10));
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    IF NULLIF(TRIM(p_name), '') IS NULL THEN RAISE EXCEPTION 'Nome do pacote é obrigatório.'; END IF;
    IF p_fee IS NULL OR p_fee < 0 THEN RAISE EXCEPTION 'Mensalidade inválida.'; END IF;
    INSERT INTO public.ambassador_fee_packages(id, name, monthly_fee, active, sort_order)
    VALUES (v_id, TRIM(p_name), p_fee, COALESCE(p_active, TRUE), COALESCE((SELECT MAX(sort_order) + 1 FROM public.ambassador_fee_packages), 1))
    ON CONFLICT (id) DO UPDATE SET name = EXCLUDED.name, monthly_fee = EXCLUDED.monthly_fee, active = EXCLUDED.active, updated_at = NOW();
    PERFORM public.fn_amb_audit('FEE_PACKAGE_SAVED', NULL, NULL, NULL, jsonb_build_object('id', v_id, 'name', TRIM(p_name), 'fee', p_fee, 'active', COALESCE(p_active, TRUE)));
    RETURN jsonb_build_object('success', TRUE, 'id', v_id);
END; $function$

07 | FUNCAO: public.fn_admin_schedule_ambassador_rates | ASSINATURA: p_ambassador_id text, p_direct numeric, p_indirect numeric, p_effective_from date, p_reason text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_schedule_ambassador_rates(p_ambassador_id text, p_direct numeric, p_indirect numeric, p_effective_from date, p_reason text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE v public.ambassadors%ROWTYPE; v_from DATE := COALESCE(p_effective_from, CURRENT_DATE);
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    IF v_from < CURRENT_DATE THEN RAISE EXCEPTION 'A data de vigência não pode estar no passado (as comissões fechadas não são alteradas).'; END IF;
    IF p_direct IS NULL OR p_direct < 0 OR p_direct > 100 THEN RAISE EXCEPTION 'Comissão inválida (0 a 100).'; END IF;
    IF p_indirect IS NULL OR p_indirect < 0 OR p_indirect > 100 THEN RAISE EXCEPTION 'Comissão indirecta inválida (0 a 100).'; END IF;
    SELECT * INTO v FROM public.ambassadors WHERE id = p_ambassador_id AND deleted_at IS NULL;
    IF v.id IS NULL THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;
    IF p_indirect > 0 AND NOT COALESCE(v.is_super, FALSE) THEN RAISE EXCEPTION 'Só Super Embaixadores podem ter comissão indirecta.'; END IF;

    IF v_from = CURRENT_DATE THEN
        PERFORM public.fn_admin_set_ambassador_rates(v.id, p_direct, p_indirect);
    ELSE
        INSERT INTO public.ambassador_rate_schedule(ambassador_id, direct_rate, indirect_rate, effective_from, reason)
        VALUES (v.id, p_direct, p_indirect, v_from, p_reason);
    END IF;
    PERFORM public.fn_amb_audit('RATES_CHANGED', v.id, NULL, p_reason,
        jsonb_build_object('direct', p_direct, 'indirect', p_indirect, 'effective_from', v_from, 'previous_direct', v.commission_rate, 'previous_indirect', v.indirect_commission_rate));
    RETURN jsonb_build_object('success', TRUE, 'applied_now', v_from = CURRENT_DATE, 'effective_from', v_from);
END; $function$

07 | FUNCAO: public.fn_admin_set_ambassador_hierarchy | ASSINATURA: p_ambassador_id text, p_is_super boolean, p_parent_id text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_set_ambassador_hierarchy(p_ambassador_id text, p_is_super boolean, p_parent_id text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE v public.ambassadors%ROWTYPE; par public.ambassadors%ROWTYPE;
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    SELECT * INTO v FROM public.ambassadors WHERE id = p_ambassador_id FOR UPDATE;
    IF v.id IS NULL THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;

    p_parent_id := NULLIF(TRIM(COALESCE(p_parent_id, '')), '');
    IF COALESCE(p_is_super, FALSE) AND p_parent_id IS NOT NULL THEN
        RAISE EXCEPTION 'Um Super Embaixador não pode ter Super Embaixador acima.';
    END IF;
    IF p_parent_id IS NOT NULL THEN
        IF p_parent_id = v.id THEN RAISE EXCEPTION 'Um embaixador não pode ser o seu próprio Super Embaixador.'; END IF;
        SELECT * INTO par FROM public.ambassadors WHERE id = p_parent_id;
        IF par.id IS NULL OR NOT COALESCE(par.is_super, FALSE) THEN
            RAISE EXCEPTION 'O responsável escolhido não é um Super Embaixador.';
        END IF;
    END IF;
    IF NOT COALESCE(p_is_super, FALSE) AND COALESCE(v.is_super, FALSE)
       AND EXISTS (SELECT 1 FROM public.ambassadors WHERE parent_ambassador_id = v.id) THEN
        RAISE EXCEPTION 'Este Super Embaixador ainda tem embaixadores na rede. Retire-os primeiro.';
    END IF;

    IF COALESCE(v.is_super, FALSE) IS DISTINCT FROM COALESCE(p_is_super, FALSE) THEN
        INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value)
        VALUES (v.id, 'is_super', COALESCE(v.is_super, FALSE)::TEXT, COALESCE(p_is_super, FALSE)::TEXT);
    END IF;
    IF v.parent_ambassador_id IS DISTINCT FROM p_parent_id THEN
        INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value)
        VALUES (v.id, 'parent_ambassador_id', v.parent_ambassador_id, p_parent_id);
    END IF;

    UPDATE public.ambassadors
       SET is_super = COALESCE(p_is_super, FALSE),
           parent_ambassador_id = p_parent_id,
           indirect_commission_rate = CASE WHEN COALESCE(p_is_super, FALSE) THEN indirect_commission_rate ELSE 0 END
     WHERE id = v.id;
    RETURN jsonb_build_object('success', TRUE);
END;
$function$

07 | FUNCAO: public.fn_admin_set_ambassador_profile | ASSINATURA: p_ambassador_id text, p_name text, p_phone text, p_whatsapp text, p_email text, p_language text, p_currency text, p_country text, p_province text, p_district text, p_city text, p_neighborhood text, p_geo_description text, p_reason text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_set_ambassador_profile(p_ambassador_id text, p_name text, p_phone text, p_whatsapp text, p_email text, p_language text, p_currency text, p_country text, p_province text, p_district text, p_city text, p_neighborhood text, p_geo_description text, p_reason text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE a public.ambassadors%ROWTYPE;
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    IF NULLIF(TRIM(COALESCE(p_name, '')), '') IS NULL THEN RAISE EXCEPTION 'Nome é obrigatório.'; END IF;
    IF NULLIF(TRIM(COALESCE(p_phone, '')), '') IS NULL THEN RAISE EXCEPTION 'Telefone é obrigatório.'; END IF;
    IF p_language IS NULL OR NOT public.fn_valid_language(p_language) THEN RAISE EXCEPTION 'Seleccione o idioma (obrigatório).'; END IF;
    IF p_currency IS NULL OR NOT public.fn_valid_currency(p_currency) THEN RAISE EXCEPTION 'Seleccione a moeda (obrigatório).'; END IF;
    SELECT * INTO a FROM public.ambassadors WHERE id = p_ambassador_id AND deleted_at IS NULL FOR UPDATE;
    IF a.id IS NULL THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;

    UPDATE public.ambassadors
       SET name = TRIM(p_name), phone = TRIM(p_phone),
           whatsapp = NULLIF(TRIM(COALESCE(p_whatsapp, '')), ''), email = NULLIF(TRIM(COALESCE(p_email, '')), ''),
           language = p_language, currency = p_currency,
           geo_country = NULLIF(TRIM(COALESCE(p_country, '')), ''), geo_province = NULLIF(TRIM(COALESCE(p_province, '')), ''),
           geo_district = NULLIF(TRIM(COALESCE(p_district, '')), ''), geo_city = NULLIF(TRIM(COALESCE(p_city, '')), ''),
           geo_neighborhood = NULLIF(TRIM(COALESCE(p_neighborhood, '')), ''), geo_description = NULLIF(TRIM(COALESCE(p_geo_description, '')), '')
     WHERE id = a.id;
    -- Só a preferência de apresentação muda; registos financeiros históricos não são tocados.
    PERFORM public.fn_amb_audit('PROFILE_EDITED', a.id, NULL, p_reason,
        jsonb_build_object('old', jsonb_build_object('name', a.name, 'phone', a.phone, 'language', a.language, 'currency', a.currency,
                                                      'country', a.geo_country, 'province', a.geo_province, 'district', a.geo_district, 'city', a.geo_city, 'neighborhood', a.geo_neighborhood),
                           'new', jsonb_build_object('name', TRIM(p_name), 'phone', TRIM(p_phone), 'language', p_language, 'currency', p_currency,
                                                      'country', p_country, 'province', p_province, 'district', p_district, 'city', p_city, 'neighborhood', p_neighborhood)));
    RETURN jsonb_build_object('success', TRUE);
END; $function$

07 | FUNCAO: public.fn_admin_set_ambassador_rates | ASSINATURA: p_ambassador_id text, p_direct numeric, p_indirect numeric | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_set_ambassador_rates(p_ambassador_id text, p_direct numeric, p_indirect numeric)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE v public.ambassadors%ROWTYPE;
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    IF p_direct IS NULL OR p_direct < 0 OR p_direct > 100 THEN RAISE EXCEPTION 'Comissão directa inválida (0 a 100).'; END IF;
    IF p_indirect IS NULL OR p_indirect < 0 OR p_indirect > 100 THEN RAISE EXCEPTION 'Comissão indirecta inválida (0 a 100).'; END IF;
    SELECT * INTO v FROM public.ambassadors WHERE id = p_ambassador_id FOR UPDATE;
    IF v.id IS NULL THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;
    IF p_indirect > 0 AND NOT COALESCE(v.is_super, FALSE) THEN
        RAISE EXCEPTION 'Só Super Embaixadores podem ter comissão indirecta.';
    END IF;

    IF v.commission_rate IS DISTINCT FROM p_direct THEN
        INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value)
        VALUES (v.id, 'commission_rate', v.commission_rate::TEXT, p_direct::TEXT);
    END IF;
    IF COALESCE(v.indirect_commission_rate, 0) IS DISTINCT FROM p_indirect THEN
        INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value)
        VALUES (v.id, 'indirect_commission_rate', COALESCE(v.indirect_commission_rate, 0)::TEXT, p_indirect::TEXT);
    END IF;

    UPDATE public.ambassadors SET commission_rate = p_direct, indirect_commission_rate = p_indirect WHERE id = v.id;
    RETURN jsonb_build_object('success', TRUE);
END;
$function$

07 | FUNCAO: public.fn_admin_set_ambassador_status | ASSINATURA: p_ambassador_id text, p_status text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_set_ambassador_status(p_ambassador_id text, p_status text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    v_status TEXT := UPPER(TRIM(COALESCE(p_status, '')));
    v_user UUID;
BEGIN
    IF public.get_auth_user_role() IS DISTINCT FROM 'SUPERADMIN' THEN
        RAISE EXCEPTION 'Apenas o Super Admin pode alterar o estado de embaixadores.';
    END IF;
    IF v_status NOT IN ('ATIVO', 'BLOQUEADO', 'DESATIVADO') THEN
        RAISE EXCEPTION 'Estado inválido: %', p_status;
    END IF;

    UPDATE public.ambassadors
       SET status = v_status,
           active = (v_status = 'ATIVO')
     WHERE id = p_ambassador_id
    RETURNING user_id INTO v_user;

    IF NOT FOUND THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;

    -- Bloqueado/desativado deixa de entrar no sistema; desbloquear volta a permitir.
    IF v_user IS NOT NULL THEN
        UPDATE public.profiles
           SET active = (v_status = 'ATIVO'), updated_at = NOW()
         WHERE id = v_user AND role = 'EMBAIXADOR';
    END IF;

    RETURN jsonb_build_object('success', TRUE, 'status', v_status);
END;
$function$

07 | FUNCAO: public.fn_admin_set_referred_store_commission | ASSINATURA: p_referred_store_id text, p_commission_rate numeric | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_set_referred_store_commission(p_referred_store_id text, p_commission_rate numeric)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
BEGIN
    IF public.get_auth_user_role() IS DISTINCT FROM 'SUPERADMIN' THEN
        RAISE EXCEPTION 'Apenas o Super Admin pode alterar a comissão de uma loja.';
    END IF;
    IF p_commission_rate IS NULL OR p_commission_rate < 0 OR p_commission_rate > 100 THEN
        RAISE EXCEPTION 'Taxa de comissão inválida (0 a 100).';
    END IF;

    UPDATE public.ambassador_referred_stores
       SET commission_rate = p_commission_rate
     WHERE id = p_referred_store_id;

    IF NOT FOUND THEN RAISE EXCEPTION 'Loja indicada não encontrada.'; END IF;
    RETURN jsonb_build_object('success', TRUE, 'commission_rate', p_commission_rate);
END;
$function$

07 | FUNCAO: public.fn_admin_soft_delete_ambassador | ASSINATURA: p_ambassador_id text, p_reason text, p_target_id text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_soft_delete_ambassador(p_ambassador_id text, p_reason text, p_target_id text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE a public.ambassadors%ROWTYPE; t public.ambassadors%ROWTYPE; c RECORD; v_n INT := 0; v_s INT := 0; v_has BOOLEAN;
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    IF NULLIF(TRIM(COALESCE(p_reason, '')), '') IS NULL THEN RAISE EXCEPTION 'Indique o motivo.'; END IF;
    SELECT * INTO a FROM public.ambassadors WHERE id = p_ambassador_id AND deleted_at IS NULL FOR UPDATE;
    IF a.id IS NULL THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;

    v_has := EXISTS (SELECT 1 FROM public.ambassadors WHERE parent_ambassador_id = a.id AND deleted_at IS NULL)
          OR EXISTS (SELECT 1 FROM public.ambassador_referred_stores WHERE ambassador_id = a.id);
    IF v_has THEN
        SELECT * INTO t FROM public.ambassadors WHERE id = p_target_id AND deleted_at IS NULL;
        IF t.id IS NULL OR t.id = a.id OR COALESCE(t.status, 'ATIVO') <> 'ATIVO' THEN RAISE EXCEPTION 'Escolha um destino activo para receber os vínculos.'; END IF;
        -- Embaixadores da rede só podem ir para outro Super Embaixador.
        IF EXISTS (SELECT 1 FROM public.ambassadors WHERE parent_ambassador_id = a.id AND deleted_at IS NULL) AND NOT COALESCE(t.is_super, FALSE) THEN
            RAISE EXCEPTION 'A rede só pode ser transferida para um Super Embaixador.';
        END IF;
        FOR c IN SELECT id FROM public.ambassadors WHERE parent_ambassador_id = a.id AND deleted_at IS NULL FOR UPDATE LOOP
            UPDATE public.ambassadors SET parent_ambassador_id = t.id WHERE id = c.id;
            INSERT INTO public.ambassador_transfers(kind, subject_id, from_id, to_id, reason, details)
            VALUES ('AMBASSADOR', c.id, a.id, t.id, 'Eliminação do responsável: ' || TRIM(p_reason), jsonb_build_object('operation', 'DELETE'));
            v_n := v_n + 1;
        END LOOP;
        FOR c IN SELECT id, commission_rate FROM public.ambassador_referred_stores WHERE ambassador_id = a.id FOR UPDATE LOOP
            UPDATE public.ambassador_referred_stores SET ambassador_id = t.id WHERE id = c.id;
            INSERT INTO public.ambassador_transfers(kind, subject_id, from_id, to_id, reason, details)
            VALUES ('STORE', c.id, a.id, t.id, 'Eliminação do responsável: ' || TRIM(p_reason), jsonb_build_object('operation', 'DELETE', 'rate_kept', c.commission_rate));
            v_s := v_s + 1;
        END LOOP;
    END IF;

    UPDATE public.ambassadors
       SET deleted_at = NOW(), deleted_by = auth.uid(), status = 'DESATIVADO', active = FALSE,
           parent_ambassador_id = NULL, block_reason = 'Conta eliminada.', blocked_by_role = 'SUPERADMIN'
     WHERE id = a.id;
    IF a.user_id IS NOT NULL THEN UPDATE public.profiles SET active = FALSE, updated_at = NOW() WHERE id = a.user_id AND role = 'EMBAIXADOR'; END IF;
    PERFORM public.fn_amb_audit('DELETED', a.id, NULL, p_reason, jsonb_build_object('target', p_target_id, 'ambassadors_moved', v_n, 'stores_moved', v_s));
    RETURN jsonb_build_object('success', TRUE, 'ambassadors_moved', v_n, 'stores_moved', v_s);
END; $function$

07 | FUNCAO: public.fn_admin_transfer_ambassador | ASSINATURA: p_ambassador_id text, p_new_parent_id text, p_reason text, p_effective_date date | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_transfer_ambassador(p_ambassador_id text, p_new_parent_id text, p_reason text, p_effective_date date DEFAULT NULL::date)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE a public.ambassadors%ROWTYPE; t public.ambassadors%ROWTYPE; v_from DATE := COALESCE(p_effective_date, CURRENT_DATE);
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    IF NULLIF(TRIM(COALESCE(p_reason, '')), '') IS NULL THEN RAISE EXCEPTION 'Indique o motivo da transferência.'; END IF;
    IF v_from > CURRENT_DATE THEN RAISE EXCEPTION 'A data efectiva não pode ser futura.'; END IF;
    SELECT * INTO a FROM public.ambassadors WHERE id = p_ambassador_id AND deleted_at IS NULL FOR UPDATE;
    IF a.id IS NULL THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;
    IF COALESCE(a.is_super, FALSE) THEN RAISE EXCEPTION 'Um Super Embaixador não é transferido: use a despromoção.'; END IF;
    SELECT * INTO t FROM public.ambassadors WHERE id = p_new_parent_id AND deleted_at IS NULL;
    IF t.id IS NULL OR NOT COALESCE(t.is_super, FALSE) OR COALESCE(t.status, 'ATIVO') <> 'ATIVO' THEN
        RAISE EXCEPTION 'Destino inválido: tem de ser um Super Embaixador activo.';
    END IF;
    IF a.parent_ambassador_id IS NOT DISTINCT FROM t.id THEN RAISE EXCEPTION 'O embaixador já pertence a este Super Embaixador.'; END IF;

    UPDATE public.ambassadors SET parent_ambassador_id = t.id WHERE id = a.id;
    INSERT INTO public.ambassador_transfers(kind, subject_id, from_id, to_id, reason, effective_date, details)
    VALUES ('AMBASSADOR', a.id, a.parent_ambassador_id, t.id, TRIM(p_reason), v_from, jsonb_build_object('operation', 'TRANSFER'));
    INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value) VALUES (a.id, 'parent_ambassador_id', a.parent_ambassador_id, t.id);
    PERFORM public.fn_amb_audit('AMBASSADOR_TRANSFERRED', a.id, NULL, p_reason, jsonb_build_object('from', a.parent_ambassador_id, 'to', t.id, 'effective_date', v_from));
    RETURN jsonb_build_object('success', TRUE);
END; $function$

07 | FUNCAO: public.fn_admin_transfer_store | ASSINATURA: p_ref_store_id text, p_new_ambassador_id text, p_reason text, p_apply_new_rate boolean | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_transfer_store(p_ref_store_id text, p_new_ambassador_id text, p_reason text, p_apply_new_rate boolean DEFAULT true)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE r public.ambassador_referred_stores%ROWTYPE; t public.ambassadors%ROWTYPE; v_new_rate NUMERIC;
BEGIN
    IF NOT public.fn_is_superadmin() THEN RAISE EXCEPTION 'Acesso reservado ao Super Administrador.'; END IF;
    IF NULLIF(TRIM(COALESCE(p_reason, '')), '') IS NULL THEN RAISE EXCEPTION 'Indique o motivo da transferência.'; END IF;
    SELECT * INTO r FROM public.ambassador_referred_stores WHERE id = p_ref_store_id FOR UPDATE;
    IF r.id IS NULL THEN RAISE EXCEPTION 'Loja indicada não encontrada.'; END IF;
    SELECT * INTO t FROM public.ambassadors WHERE id = p_new_ambassador_id AND deleted_at IS NULL;
    IF t.id IS NULL OR COALESCE(t.status, 'ATIVO') <> 'ATIVO' THEN RAISE EXCEPTION 'Destino inválido: tem de ser um embaixador activo.'; END IF;
    IF t.id = r.ambassador_id THEN RAISE EXCEPTION 'A loja já pertence a este embaixador.'; END IF;

    v_new_rate := CASE WHEN COALESCE(p_apply_new_rate, TRUE) THEN COALESCE(t.commission_rate, r.commission_rate) ELSE r.commission_rate END;
    UPDATE public.ambassador_referred_stores SET ambassador_id = t.id, commission_rate = v_new_rate WHERE id = r.id;
    INSERT INTO public.ambassador_transfers(kind, subject_id, from_id, to_id, reason, effective_date, details)
    VALUES ('STORE', r.id, r.ambassador_id, t.id, TRIM(p_reason), CURRENT_DATE,
            jsonb_build_object('old_rate', r.commission_rate, 'new_rate', v_new_rate, 'store_id', r.store_id));
    PERFORM public.fn_amb_audit('STORE_TRANSFERRED', t.id, r.id, p_reason,
        jsonb_build_object('from', r.ambassador_id, 'to', t.id, 'old_rate', r.commission_rate, 'new_rate', v_new_rate));
    RETURN jsonb_build_object('success', TRUE, 'new_rate', v_new_rate);
END; $function$

07 | FUNCAO: public.fn_admin_update_ambassador | ASSINATURA: p_ambassador_id text, p_name text, p_phone text, p_pix_mpesa text, p_commission_rate numeric | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_admin_update_ambassador(p_ambassador_id text, p_name text, p_phone text, p_pix_mpesa text, p_commission_rate numeric)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    v_code TEXT;
BEGIN
    IF public.get_auth_user_role() IS DISTINCT FROM 'SUPERADMIN' THEN
        RAISE EXCEPTION 'Apenas o Super Admin pode editar embaixadores.';
    END IF;
    IF NULLIF(TRIM(p_name), '') IS NULL THEN RAISE EXCEPTION 'Nome do embaixador é obrigatório.'; END IF;
    IF NULLIF(TRIM(p_phone), '') IS NULL THEN RAISE EXCEPTION 'Telefone do embaixador é obrigatório.'; END IF;
    IF p_commission_rate IS NULL OR p_commission_rate < 0 OR p_commission_rate > 100 THEN
        RAISE EXCEPTION 'Taxa de comissão inválida (0 a 100).';
    END IF;

    UPDATE public.ambassadors
       SET name = TRIM(p_name),
           phone = TRIM(p_phone),
           pix_mpesa = COALESCE(NULLIF(TRIM(p_pix_mpesa), ''), pix_mpesa),
           commission_rate = p_commission_rate
     WHERE id = p_ambassador_id;

    -- Compatibilidade: o modal "Novo Embaixador" envia um id novo -> cria o registo.
    IF NOT FOUND THEN
        v_code := 'GEF-' || UPPER(REGEXP_REPLACE(SPLIT_PART(TRIM(p_name), ' ', 1), '[^A-Za-z0-9]', '', 'g'))
                  || '-' || EXTRACT(YEAR FROM NOW())::INT;
        IF EXISTS (SELECT 1 FROM public.ambassadors WHERE referral_code = v_code) THEN
            v_code := v_code || '-' || UPPER(SUBSTR(MD5(RANDOM()::TEXT), 1, 4));
        END IF;
        INSERT INTO public.ambassadors (id, name, phone, pix_mpesa, referral_code, commission_rate, status, active)
        VALUES (p_ambassador_id, TRIM(p_name), TRIM(p_phone),
                COALESCE(NULLIF(TRIM(p_pix_mpesa), ''), 'M-Pesa ' || TRIM(p_phone)),
                v_code, p_commission_rate, 'ATIVO', TRUE);
    END IF;

    SELECT referral_code INTO v_code FROM public.ambassadors WHERE id = p_ambassador_id;

    RETURN jsonb_build_object('success', TRUE, 'ambassador_id', p_ambassador_id, 'referral_code', v_code);
END;
$function$

07 | FUNCAO: public.fn_amb_audit | ASSINATURA: p_action text, p_amb text, p_store text, p_reason text, p_details jsonb | RETORNA: void | LINGUAGEM: sql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_amb_audit(p_action text, p_amb text, p_store text, p_reason text, p_details jsonb)
 RETURNS void
 LANGUAGE sql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
    INSERT INTO public.ambassador_audit_log(action, ambassador_id, store_ref_id, actor_id, actor_role, reason, details)
    VALUES (p_action, p_amb, p_store, auth.uid(), public.get_auth_user_role(), p_reason, p_details);
$function$

07 | FUNCAO: public.fn_amb_code | ASSINATURA: p_name text | RETORNA: text | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_amb_code(p_name text)
 RETURNS text
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE v TEXT := 'GEF-' || UPPER(REGEXP_REPLACE(SPLIT_PART(TRIM(p_name), ' ', 1), '[^A-Za-z0-9]', '', 'g')) || '-' || EXTRACT(YEAR FROM NOW())::INT;
BEGIN
    IF EXISTS (SELECT 1 FROM public.ambassadors WHERE referral_code = v) THEN v := v || '-' || UPPER(SUBSTR(MD5(RANDOM()::TEXT), 1, 4)); END IF;
    RETURN v;
END; $function$

07 | FUNCAO: public.fn_ambassador_context | ASSINATURA:  | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: s | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_ambassador_context()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE me public.ambassadors%ROWTYPE; par public.ambassadors%ROWTYPE;
BEGIN
    IF auth.uid() IS NULL THEN RAISE EXCEPTION 'Sessão não autenticada.'; END IF;
    SELECT * INTO me FROM public.ambassadors WHERE user_id = auth.uid() ORDER BY created_at LIMIT 1;
    IF me.id IS NULL THEN RETURN jsonb_build_object('ok', FALSE, 'code', 'AMBASSADOR_NOT_LINKED'); END IF;

    IF COALESCE(me.status, 'ATIVO') <> 'ATIVO' OR me.deleted_at IS NOT NULL THEN
        RETURN jsonb_build_object('ok', TRUE, 'blocked', TRUE, 'message', 'A sua conta está bloqueada.', 'reason', me.block_reason);
    END IF;

    IF me.parent_ambassador_id IS NOT NULL THEN
        SELECT * INTO par FROM public.ambassadors WHERE id = me.parent_ambassador_id AND deleted_at IS NULL;
    END IF;

    RETURN jsonb_build_object('ok', TRUE, 'blocked', FALSE,
        'ambassador_id', me.id, 'name', me.name, 'is_super', COALESCE(me.is_super, FALSE),
        'profile', CASE WHEN COALESCE(me.is_super, FALSE) THEN 'SUPER_EMBAIXADOR' ELSE 'EMBAIXADOR' END,
        'language', me.language, 'currency', me.currency,
        'area', concat_ws(', ', me.geo_neighborhood, me.geo_city, me.geo_district, me.geo_province, me.geo_country),
        'super_contact', CASE WHEN par.id IS NULL THEN NULL
                              ELSE jsonb_build_object('name', par.name, 'phone', par.phone, 'whatsapp', par.whatsapp) END);
END; $function$

07 | FUNCAO: public.fn_ambassador_create_store | ASSINATURA: p_ambassador_id text, p_store_name text, p_owner_name text, p_phone text, p_city text, p_monthly_fee numeric, p_contract_months integer, p_admin_email text, p_admin_password text, p_address text, p_nuit_nif text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_ambassador_create_store(p_ambassador_id text, p_store_name text, p_owner_name text, p_phone text, p_city text, p_monthly_fee numeric, p_contract_months integer, p_admin_email text, p_admin_password text, p_address text DEFAULT NULL::text, p_nuit_nif text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'extensions', 'auth', 'pg_temp'
AS $function$
DECLARE
    v_amb public.ambassadors%ROWTYPE;
    v_store_id TEXT;
    v_store_code TEXT;
    v_uid UUID;
BEGIN
    v_amb := public.fn_ambassador_resolve(p_ambassador_id, TRUE);

    IF NULLIF(TRIM(p_store_name), '') IS NULL THEN RAISE EXCEPTION 'Nome da loja é obrigatório.'; END IF;
    IF NULLIF(TRIM(p_owner_name), '') IS NULL THEN RAISE EXCEPTION 'Nome do responsável é obrigatório.'; END IF;
    IF NULLIF(TRIM(p_phone), '') IS NULL THEN RAISE EXCEPTION 'Telefone é obrigatório.'; END IF;
    IF NULLIF(TRIM(p_city), '') IS NULL THEN RAISE EXCEPTION 'Cidade é obrigatória.'; END IF;
    IF COALESCE(p_monthly_fee, 0) < 0 THEN RAISE EXCEPTION 'Mensalidade inválida.'; END IF;

    v_store_id := 'store-' || SUBSTR(REPLACE(gen_random_uuid()::TEXT, '-', ''), 1, 16);
    v_store_code := 'REF-' || UPPER(SUBSTR(MD5(RANDOM()::TEXT || CLOCK_TIMESTAMP()::TEXT), 1, 8));

    INSERT INTO public.stores (
        id, code, name, trade_name, nuit_nif, city, address, phone,
        currency, language, is_headquarters,
        valor_mensalidade, data_inicio_teste, data_fim_teste, acesso_ativo
    ) VALUES (
        v_store_id, v_store_code, TRIM(p_store_name), TRIM(p_store_name),
        NULLIF(TRIM(p_nuit_nif), ''), TRIM(p_city), NULLIF(TRIM(p_address), ''), TRIM(p_phone),
        'MT', 'pt', FALSE,
        COALESCE(p_monthly_fee, 0), NOW(), CURRENT_DATE + 30, TRUE
    );

    -- Administrador inicial da loja (definido pelo embaixador; a loja pode trocar a senha)
    v_uid := public.fn_internal_create_store_user(p_admin_email, p_admin_password, p_owner_name, 'ADMIN', v_store_id);

    INSERT INTO public.ambassador_referred_stores (
        id, store_id, ambassador_id, name, owner_name, phone, city,
        monthly_fee, payment_status, next_due_date,
        commission_rate, contract_duration_months, months_active, total_commission_earned
    ) VALUES (
        v_store_id, v_store_id, v_amb.id, TRIM(p_store_name), TRIM(p_owner_name), TRIM(p_phone), TRIM(p_city),
        COALESCE(p_monthly_fee, 0), 'PENDENTE', CURRENT_DATE + 30,
        COALESCE(v_amb.commission_rate, 15), COALESCE(NULLIF(p_contract_months, 0), 12), 0, 0
    );

    RETURN jsonb_build_object(
        'success', TRUE,
        'store_id', v_store_id,
        'store_code', v_store_code,
        'admin_user_id', v_uid,
        'admin_email', LOWER(TRIM(p_admin_email)),
        'commission_rate', COALESCE(v_amb.commission_rate, 15)
    );
END;
$function$

07 | FUNCAO: public.fn_ambassador_create_store_user | ASSINATURA: p_ambassador_id text, p_referred_store_id text, p_email text, p_password text, p_full_name text, p_role text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_ambassador_create_store_user(p_ambassador_id text, p_referred_store_id text, p_email text, p_password text, p_full_name text, p_role text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'extensions', 'auth', 'pg_temp'
AS $function$
DECLARE
    v_amb public.ambassadors%ROWTYPE;
    v_store_id TEXT;
    v_uid UUID;
BEGIN
    v_amb := public.fn_ambassador_resolve(p_ambassador_id, TRUE);

    IF UPPER(TRIM(COALESCE(p_role, ''))) NOT IN ('ADMIN', 'CASHIER') THEN
        RAISE EXCEPTION 'O embaixador só pode criar utilizadores Admin ou Caixa.';
    END IF;

    SELECT COALESCE(r.store_id, r.id) INTO v_store_id
      FROM public.ambassador_referred_stores r
     WHERE r.id = p_referred_store_id AND r.ambassador_id = v_amb.id;

    IF v_store_id IS NULL OR NOT EXISTS (SELECT 1 FROM public.stores WHERE id = v_store_id) THEN
        RAISE EXCEPTION 'Loja não encontrada ou não pertence a este embaixador.';
    END IF;

    v_uid := public.fn_internal_create_store_user(p_email, p_password, p_full_name, UPPER(TRIM(p_role)), v_store_id);
    RETURN jsonb_build_object('success', TRUE, 'user_id', v_uid, 'email', LOWER(TRIM(p_email)));
END;
$function$

07 | FUNCAO: public.fn_ambassador_is_active | ASSINATURA: p_ambassador_id text | RETORNA: boolean | LINGUAGEM: sql | SECURITY DEFINER: true | VOLATILIDADE: s | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_ambassador_is_active(p_ambassador_id text)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
    SELECT EXISTS (SELECT 1 FROM public.ambassadors a
                    WHERE a.id = p_ambassador_id AND a.user_id = auth.uid()
                      AND COALESCE(a.status, 'ATIVO') = 'ATIVO' AND a.deleted_at IS NULL);
$function$

07 | FUNCAO: public.fn_ambassador_portal | ASSINATURA: p_ambassador_id text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: s | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_ambassador_portal(p_ambassador_id text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    v_uid        UUID := auth.uid();
    v_role       TEXT;
    v_amb        public.ambassadors%ROWTYPE;
    v_amb_json   JSONB;
    v_stores     JSONB := '[]'::JSONB;
    v_payments   JSONB := '[]'::JSONB;
    v_payouts    JSONB := '[]'::JSONB;
    v_generated  NUMERIC := 0;
    v_paid       NUMERIC := 0;
    v_warnings   JSONB := '[]'::JSONB;
BEGIN
    IF v_uid IS NULL THEN
        RAISE EXCEPTION 'Sessão não autenticada.';
    END IF;

    SELECT role INTO v_role FROM public.profiles WHERE id = v_uid;

    IF v_role = 'SUPERADMIN' AND p_ambassador_id IS NOT NULL THEN
        SELECT * INTO v_amb FROM public.ambassadors WHERE id = p_ambassador_id;
    ELSE
        -- Qualquer outro utilizador só pode ver o registo ligado ao seu próprio login.
        SELECT * INTO v_amb FROM public.ambassadors WHERE user_id = v_uid ORDER BY created_at LIMIT 1;
    END IF;

    IF v_amb.id IS NULL THEN
        RETURN JSONB_BUILD_OBJECT(
            'ok', FALSE,
            'code', 'AMBASSADOR_NOT_LINKED',
            'message', 'Não existe um cadastro de embaixador ligado a este login.'
        );
    END IF;

    -- v7: conta bloqueada/eliminada -> só mensagem e motivo, nenhum dado operacional.
    IF v_role IS DISTINCT FROM 'SUPERADMIN'
       AND (COALESCE(v_amb.status, 'ATIVO') <> 'ATIVO' OR v_amb.deleted_at IS NOT NULL) THEN
        RETURN JSONB_BUILD_OBJECT('ok', FALSE, 'code', 'BLOCKED',
                                  'message', 'A sua conta está bloqueada.', 'reason', v_amb.block_reason);
    END IF;

    v_amb_json := JSONB_BUILD_OBJECT(
        'id', v_amb.id,
        'user_id', v_amb.user_id,
        'name', v_amb.name,
        'phone', v_amb.phone,
        'pix_mpesa', v_amb.pix_mpesa,
        'referral_code', v_amb.referral_code,
        'commission_rate', COALESCE(v_amb.commission_rate, 0),
        'status', COALESCE(TO_JSONB(v_amb)->>'status',
                           CASE WHEN v_amb.active = FALSE THEN 'DESATIVADO' ELSE 'ATIVO' END),
        'pending_commissions', COALESCE(v_amb.pending_commissions, 0),
        'total_earned', COALESCE(v_amb.total_earned, 0),
        'created_at', v_amb.created_at
    );

    -- ---------------- LOJAS VINCULADAS (subscrição + comissão por loja) ----------------
    BEGIN
        SELECT COALESCE(JSONB_AGG(t.x ORDER BY t.created DESC NULLS LAST), '[]'::JSONB)
          INTO v_stores
          FROM (
            SELECT r.created_at AS created,
                   JSONB_BUILD_OBJECT(
                       'id', r.id,
                       'name', r.name,
                       'owner_name', r.owner_name,
                       'phone', r.phone,
                       'city', r.city,
                       'address', s.address,
                       'province', s.province,
                       'admin_email', (SELECT pf.email FROM public.profiles pf
                                        WHERE pf.store_id = s.id AND pf.role = 'ADMIN'
                                        ORDER BY pf.created_at, pf.email LIMIT 1),
                       'admin_name', (SELECT pf.full_name FROM public.profiles pf
                                        WHERE pf.store_id = s.id AND pf.role = 'ADMIN'
                                        ORDER BY pf.created_at, pf.email LIMIT 1),
                       'created_at', r.created_at,
                       'monthly_fee', COALESCE(s.valor_mensalidade, r.monthly_fee, 0),
                       'commission_rate', COALESCE(r.commission_rate, v_amb.commission_rate, 0),
                       'contract_duration_months', COALESCE(r.contract_duration_months, 12),
                       'months_active', COALESCE(r.months_active, 0),
                       'has_store', (s.id IS NOT NULL),
                       'subscription_status', CASE
                            WHEN s.id IS NULL THEN 'SEM_LOJA'
                            WHEN s.acesso_ativo = FALSE THEN 'BLOQUEADA'
                            WHEN s.data_fim_teste < CURRENT_DATE THEN 'EXPIRADA'
                            WHEN r.last_payment_date IS NULL THEN 'EM_TESTE'
                            ELSE 'ATIVA' END,
                       'subscription_end', s.data_fim_teste,
                       'days_remaining', CASE WHEN s.id IS NULL THEN NULL
                                              ELSE (s.data_fim_teste - CURRENT_DATE) END,
                       'last_payment_date', r.last_payment_date,
                       'payments_count', (SELECT COUNT(*) FROM public.ambassador_commission_payments p
                                           WHERE p.referred_store_id = r.id),
                       'total_paid_by_store', (SELECT COALESCE(SUM(p.payment_amount), 0)
                                                 FROM public.ambassador_commission_payments p
                                                WHERE p.referred_store_id = r.id),
                       'total_commission', (SELECT COALESCE(SUM(p.commission_amount), 0)
                                              FROM public.ambassador_commission_payments p
                                             WHERE p.referred_store_id = r.id)
                   ) AS x
              FROM public.ambassador_referred_stores r
              LEFT JOIN LATERAL (
                    SELECT q.* FROM (
                        SELECT s1.*, 1 AS prio
                          FROM public.stores s1
                         WHERE s1.id = COALESCE(r.store_id, r.id)
                        UNION ALL
                        SELECT s2.*, 2 AS prio
                          FROM public.stores s2
                         WHERE r.store_id IS NULL
                           AND NOT EXISTS (SELECT 1 FROM public.stores x1 WHERE x1.id = r.id)
                           AND REGEXP_REPLACE(COALESCE(r.phone, ''), '\D', '', 'g') <> ''
                           AND LOWER(TRIM(s2.name)) = LOWER(TRIM(r.name))
                           AND REGEXP_REPLACE(COALESCE(s2.phone, ''), '\D', '', 'g')
                             = REGEXP_REPLACE(COALESCE(r.phone, ''), '\D', '', 'g')
                           AND NOT EXISTS (SELECT 1 FROM public.ambassador_referred_stores z
                                            WHERE z.store_id = s2.id)
                           AND (SELECT COUNT(*) FROM public.stores y
                                 WHERE LOWER(TRIM(y.name)) = LOWER(TRIM(r.name))
                                   AND REGEXP_REPLACE(COALESCE(y.phone, ''), '\D', '', 'g')
                                     = REGEXP_REPLACE(COALESCE(r.phone, ''), '\D', '', 'g')) = 1
                    ) q
                    ORDER BY q.prio
                    LIMIT 1
              ) s ON TRUE
             WHERE r.ambassador_id = v_amb.id
          ) t;
    EXCEPTION WHEN OTHERS THEN
        v_warnings := v_warnings || TO_JSONB('lojas: ' || SQLERRM);
    END;

    -- ---------------- COMISSÃO GERADA EM CADA PAGAMENTO ----------------
    BEGIN
        SELECT COALESCE(JSONB_AGG(JSONB_BUILD_OBJECT(
                   'id', p.id,
                   'referred_store_id', p.referred_store_id,
                   'store_name', p.store_name,
                   'paid_at', p.paid_at,
                   'payment_amount', p.payment_amount,
                   'commission_rate', p.commission_rate,
                   'commission_amount', p.commission_amount,
                   'days_added', p.days_added
               ) ORDER BY p.paid_at DESC), '[]'::JSONB),
               COALESCE(SUM(p.commission_amount), 0)
          INTO v_payments, v_generated
          FROM public.ambassador_commission_payments p
         WHERE p.ambassador_id = v_amb.id;
    EXCEPTION WHEN OTHERS THEN
        v_warnings := v_warnings || TO_JSONB('pagamentos: ' || SQLERRM);
    END;

    -- ---------------- HISTÓRICO DE LIQUIDAÇÕES (comissão recebida) ----------------
    BEGIN
        SELECT COALESCE(JSONB_AGG(JSONB_BUILD_OBJECT(
                   'id', po.id,
                   'amount', po.amount,
                   'method', po.method,
                   'receipt', po.receipt,
                   'status', po.status,
                   'created_at', po.created_at
               ) ORDER BY po.created_at DESC), '[]'::JSONB),
               COALESCE(SUM(po.amount), 0)
          INTO v_payouts, v_paid
          FROM public.ambassador_payouts po
         WHERE po.ambassador_id = v_amb.id;
    EXCEPTION WHEN OTHERS THEN
        v_warnings := v_warnings || TO_JSONB('liquidacoes: ' || SQLERRM);
    END;

    RETURN JSONB_BUILD_OBJECT(
        'ok', TRUE,
        'generated_at', NOW(),
        'ambassador', v_amb_json,
        'stores', v_stores,
        'payments', v_payments,
        'payouts', v_payouts,
        'total_commission_generated', v_generated,
        'available_commission', COALESCE(v_amb.pending_commissions, 0),
        'paid_commission', v_paid,
        'warnings', v_warnings
    );
END;
$function$

07 | FUNCAO: public.fn_ambassador_resolve | ASSINATURA: p_ambassador_id text, p_require_active boolean | RETORNA: ambassadors | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_ambassador_resolve(p_ambassador_id text, p_require_active boolean DEFAULT true)
 RETURNS ambassadors
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    v_amb public.ambassadors%ROWTYPE;
    v_role TEXT := public.get_auth_user_role();
BEGIN
    IF auth.uid() IS NULL THEN RAISE EXCEPTION 'Sessão não autenticada.'; END IF;

    IF p_ambassador_id IS NULL THEN
        SELECT * INTO v_amb FROM public.ambassadors WHERE user_id = auth.uid() LIMIT 1;
    ELSE
        SELECT * INTO v_amb FROM public.ambassadors WHERE id = p_ambassador_id;
    END IF;
    IF v_amb.id IS NULL THEN RAISE EXCEPTION 'Embaixador não encontrado.'; END IF;

    IF v_role = 'SUPERADMIN' THEN RETURN v_amb; END IF;

    IF v_amb.user_id IS DISTINCT FROM auth.uid() THEN
        RAISE EXCEPTION 'Sem permissão para operar como este embaixador.';
    END IF;
    IF COALESCE(v_amb.status, 'ATIVO') <> 'ATIVO' OR v_amb.deleted_at IS NOT NULL THEN
        RAISE EXCEPTION 'A sua conta está bloqueada. Contacte o administrador.';
    END IF;
    RETURN v_amb;
END; $function$

07 | FUNCAO: public.fn_ambassador_tracking | ASSINATURA: p_ambassador_id text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: s | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_ambassador_tracking(p_ambassador_id text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    v_amb public.ambassadors%ROWTYPE;
    v_stores JSONB;
    v_payments JSONB;
    v_paid NUMERIC(12, 2);
BEGIN
    v_amb := public.fn_ambassador_resolve(p_ambassador_id, FALSE);

    SELECT COALESCE(JSONB_AGG(x ORDER BY x->>'created_at' DESC), '[]'::JSONB) INTO v_stores
    FROM (
        SELECT JSONB_BUILD_OBJECT(
            'id', r.id,
            'name', r.name,
            'owner_name', r.owner_name,
            'phone', r.phone,
            'city', r.city,
            'address', s.address,
            'province', s.province,
            'admin_email', (SELECT pf.email FROM public.profiles pf
                             WHERE pf.store_id = s.id AND pf.role = 'ADMIN'
                             ORDER BY pf.email LIMIT 1),
            'created_at', r.created_at,
            'monthly_fee', COALESCE(s.valor_mensalidade, r.monthly_fee, 0),
            'commission_rate', COALESCE(r.commission_rate, v_amb.commission_rate, 0),
            'contract_duration_months', r.contract_duration_months,
            'months_active', COALESCE(r.months_active, 0),
            'has_store', (s.id IS NOT NULL),
            'subscription_status', CASE
                WHEN s.id IS NULL THEN 'SEM_LOJA'
                WHEN s.acesso_ativo = FALSE THEN 'BLOQUEADA'
                WHEN s.data_fim_teste < CURRENT_DATE THEN 'EXPIRADA'
                WHEN r.last_payment_date IS NULL THEN 'EM_TESTE'
                ELSE 'ATIVA' END,
            'subscription_end', s.data_fim_teste,
            'days_remaining', CASE WHEN s.id IS NULL THEN NULL ELSE (s.data_fim_teste - CURRENT_DATE) END,
            'last_payment_date', r.last_payment_date,
            'payments_count', (SELECT COUNT(*) FROM public.ambassador_commission_payments p WHERE p.referred_store_id = r.id),
            'total_paid_by_store', (SELECT COALESCE(SUM(p.payment_amount), 0) FROM public.ambassador_commission_payments p WHERE p.referred_store_id = r.id),
            'total_commission', (SELECT COALESCE(SUM(p.commission_amount), 0) FROM public.ambassador_commission_payments p WHERE p.referred_store_id = r.id)
        ) AS x
        FROM public.ambassador_referred_stores r
        LEFT JOIN public.stores s ON s.id = COALESCE(r.store_id, r.id)
        WHERE r.ambassador_id = v_amb.id
    ) t;

    SELECT COALESCE(JSONB_AGG(JSONB_BUILD_OBJECT(
        'id', p.id,
        'referred_store_id', p.referred_store_id,
        'store_name', p.store_name,
        'paid_at', p.paid_at,
        'payment_amount', p.payment_amount,
        'commission_rate', p.commission_rate,
        'commission_amount', p.commission_amount,
        'days_added', p.days_added
    ) ORDER BY p.paid_at DESC), '[]'::JSONB) INTO v_payments
    FROM public.ambassador_commission_payments p
    WHERE p.ambassador_id = v_amb.id;

    SELECT COALESCE(SUM(amount), 0) INTO v_paid
      FROM public.ambassador_payouts WHERE ambassador_id = v_amb.id;

    RETURN JSONB_BUILD_OBJECT(
        'ambassador_id', v_amb.id,
        'stores', v_stores,
        'payments', v_payments,
        'total_commission_generated', (SELECT COALESCE(SUM(commission_amount), 0) FROM public.ambassador_commission_payments WHERE ambassador_id = v_amb.id),
        'available_commission', COALESCE(v_amb.pending_commissions, 0),
        'paid_commission', v_paid
    );
END;
$function$

07 | FUNCAO: public.fn_ambassadors_require_prefs | ASSINATURA:  | RETORNA: trigger | LINGUAGEM: plpgsql | SECURITY DEFINER: false | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_ambassadors_require_prefs()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    IF NEW.language IS NULL OR NOT public.fn_valid_language(NEW.language) THEN RAISE EXCEPTION 'Seleccione o idioma (obrigatório).'; END IF;
    IF NEW.currency IS NULL OR NOT public.fn_valid_currency(NEW.currency) THEN RAISE EXCEPTION 'Seleccione a moeda (obrigatório).'; END IF;
    RETURN NEW;
END; $function$

07 | FUNCAO: public.fn_apply_due_rate_changes | ASSINATURA:  | RETORNA: integer | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_apply_due_rate_changes()
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE r RECORD; n INT := 0; v public.ambassadors%ROWTYPE;
BEGIN
    FOR r IN SELECT * FROM public.ambassador_rate_schedule WHERE applied_at IS NULL AND effective_from <= CURRENT_DATE ORDER BY effective_from, id FOR UPDATE SKIP LOCKED LOOP
        SELECT * INTO v FROM public.ambassadors WHERE id = r.ambassador_id FOR UPDATE;
        IF v.id IS NOT NULL THEN
            IF v.commission_rate IS DISTINCT FROM r.direct_rate THEN
                INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value, changed_by)
                VALUES (v.id, 'commission_rate', v.commission_rate::TEXT, r.direct_rate::TEXT, r.created_by);
            END IF;
            IF COALESCE(v.indirect_commission_rate, 0) IS DISTINCT FROM r.indirect_rate THEN
                INSERT INTO public.ambassador_rate_audit(ambassador_id, field, old_value, new_value, changed_by)
                VALUES (v.id, 'indirect_commission_rate', COALESCE(v.indirect_commission_rate, 0)::TEXT, r.indirect_rate::TEXT, r.created_by);
            END IF;
            UPDATE public.ambassadors
               SET commission_rate = r.direct_rate,
                   indirect_commission_rate = CASE WHEN COALESCE(is_super, FALSE) THEN r.indirect_rate ELSE 0 END
             WHERE id = v.id;
        END IF;
        UPDATE public.ambassador_rate_schedule SET applied_at = NOW() WHERE id = r.id;
        n := n + 1;
    END LOOP;
    RETURN n;
END; $function$

07 | FUNCAO: public.fn_approve_ambassador_store | ASSINATURA: p_referred_store_id text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_approve_ambassador_store(p_referred_store_id text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
    v_role TEXT;
    v_ref public.ambassador_referred_stores%ROWTYPE;
BEGIN

    -- Verificar Superadmin
    v_role := get_auth_user_role();

    IF v_role <> 'SUPERADMIN' THEN
        RAISE EXCEPTION 'Apenas o Superadmin pode aprovar cadastros.';
    END IF;


    -- Buscar indicação
    SELECT *
    INTO v_ref
    FROM public.ambassador_referred_stores
    WHERE id = p_referred_store_id
    FOR UPDATE;


    IF v_ref.id IS NULL THEN
        RAISE EXCEPTION 'Cadastro de loja indicada não encontrado.';
    END IF;


    IF COALESCE(v_ref.registration_status, 'PENDENTE') = 'APROVADA' THEN
        RETURN jsonb_build_object(
            'success', TRUE,
            'status', 'APROVADA',
            'message', 'Este cadastro já está aprovado.'
        );
    END IF;


    -- Atualizar indicação
    UPDATE public.ambassador_referred_stores
    SET registration_status = 'APROVADA'
    WHERE id = v_ref.id;


    -- Liberar loja
    IF v_ref.store_id IS NOT NULL THEN

        UPDATE public.stores
        SET
            acesso_ativo = TRUE,
            motivo_bloqueio = NULL,
            updated_at = now()
        WHERE id = v_ref.store_id;

    END IF;


    RETURN jsonb_build_object(
        'success', TRUE,
        'status', 'APROVADA',
        'store_id', v_ref.store_id,
        'message', 'Cadastro aprovado e acesso da loja liberado.'
    );

END;
$function$

07 | FUNCAO: public.fn_assert_store_access | ASSINATURA: p_store_id text, p_allowed_roles text[] | RETORNA: void | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_assert_store_access(p_store_id text, p_allowed_roles text[] DEFAULT NULL::text[])
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    v_role TEXT;
    v_active BOOLEAN;
BEGIN

    IF auth.uid() IS NULL THEN
        RAISE EXCEPTION 'Sessão não autenticada.';
    END IF;

    SELECT role, active
    INTO v_role, v_active
    FROM public.profiles
    WHERE id = auth.uid();

    IF v_role IS NULL THEN
        RAISE EXCEPTION 'Perfil do utilizador não encontrado.';
    END IF;

    IF v_role = 'SUPERADMIN' THEN
        RETURN;
    END IF;

    IF COALESCE(v_active, FALSE) = FALSE THEN
        RAISE EXCEPTION 'O seu perfil está inativo.';
    END IF;

    IF p_store_id IS DISTINCT FROM public.get_auth_user_store_id() THEN
        RAISE EXCEPTION 'Sem permissão para operar nesta loja.';
    END IF;

    IF p_allowed_roles IS NOT NULL
       AND NOT (v_role = ANY(p_allowed_roles))
    THEN
        RAISE EXCEPTION
            'O seu perfil (%) não tem permissão para esta operação.',
            v_role;
    END IF;

END;
$function$

07 | FUNCAO: public.fn_close_cash_session | ASSINATURA: p_session_id text, p_counted_cash numeric, p_notes text, p_operator_id uuid | RETORNA: cash_sessions | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_close_cash_session(p_session_id text, p_counted_cash numeric, p_notes text, p_operator_id uuid)
 RETURNS cash_sessions
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    v_session public.cash_sessions;
    v_expected NUMERIC;
BEGIN

    p_operator_id := auth.uid();

    SELECT *
    INTO v_session
    FROM public.cash_sessions
    WHERE id = p_session_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION
            'Sessão de caixa não encontrada.';
    END IF;


    PERFORM public.fn_assert_store_access(
        v_session.store_id
    );


    IF v_session.is_closed THEN
        RAISE EXCEPTION
            'Sessão já está fechada.';
    END IF;


    SELECT
        v_session.opening_balance
        +
        COALESCE(
            SUM(
                CASE
                    WHEN cm.movement_type = 'SALE'
                         AND cm.payment_method IN ('DINHEIRO','CASH')
                        THEN cm.amount

                    WHEN cm.movement_type = 'REFORCO'
                        THEN cm.amount

                    WHEN cm.movement_type IN (
                        'SANGRIA_BANK',
                        'SANGRIA_SAFE',
                        'DESPESA'
                    )
                        THEN -cm.amount

                    WHEN cm.movement_type = 'ESTORNO'
                         AND cm.payment_method IN ('DINHEIRO','CASH')
                        THEN -cm.amount

                    ELSE 0
                END
            ),
            0
        )
    INTO v_expected
    FROM public.cash_movements cm
    WHERE cm.session_id = p_session_id;


    UPDATE public.cash_sessions
    SET
        closed_at = NOW(),
        declared_cash = p_counted_cash,
        expected_cash = v_expected,
        difference = p_counted_cash - v_expected,
        is_closed = TRUE,
        notes = p_notes
    WHERE id = p_session_id
    RETURNING *
    INTO v_session;


    INSERT INTO public.audit_logs (
        id,
        store_id,
        action,
        entity,
        entity_id,
        details,
        operator_id
    )
    VALUES (
        'audit-' || gen_random_uuid()::TEXT,
        v_session.store_id,
        'FECHAMENTO_CAIXA',
        'cash_sessions',
        p_session_id,
        'Fechamento. Esperado: '
        || v_expected
        || ', Contado: '
        || p_counted_cash
        || ', Diferença: '
        || (p_counted_cash - v_expected),
        p_operator_id
    );


    RETURN v_session;

END;
$function$

07 | FUNCAO: public.fn_complete_ambassador_onboarding | ASSINATURA: p_ambassador_code text, p_store_name text, p_owner_name text, p_phone text, p_city text, p_address text, p_nuit_nif text, p_monthly_fee numeric, p_admin_email text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_complete_ambassador_onboarding(p_ambassador_code text, p_store_name text, p_owner_name text, p_phone text, p_city text, p_address text, p_nuit_nif text, p_monthly_fee numeric, p_admin_email text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
    v_user_id UUID;
    v_ambassador_id TEXT;
    v_ambassador_status TEXT;
    v_store_id TEXT;
    v_referred_store_id TEXT;
BEGIN

    -- ========================================================
    -- 1. UTILIZADOR AUTENTICADO
    -- ========================================================

    v_user_id := auth.uid();

    IF v_user_id IS NULL THEN
        RAISE EXCEPTION
            'É necessário estar autenticado para concluir a adesão.';
    END IF;


    -- ========================================================
    -- 2. VALIDAR EMBAIXADOR
    -- ========================================================

    SELECT
        id,
        COALESCE(status, 'ATIVO')
    INTO
        v_ambassador_id,
        v_ambassador_status
    FROM public.ambassadors
    WHERE referral_code = TRIM(p_ambassador_code)
    LIMIT 1;


    IF v_ambassador_id IS NULL THEN
        RAISE EXCEPTION
            'Código de embaixador inválido.';
    END IF;


    -- ========================================================
    -- 3. BLOQUEIO REAL NO BANCO
    -- ========================================================

    IF v_ambassador_status = 'BLOQUEADO' THEN
        RAISE EXCEPTION
            'Este embaixador está bloqueado e não pode cadastrar novas lojas.';
    END IF;


    IF v_ambassador_status = 'DESATIVADO' THEN
        RAISE EXCEPTION
            'Este embaixador está desativado e não pode cadastrar novas lojas.';
    END IF;


    IF v_ambassador_status <> 'ATIVO' THEN
        RAISE EXCEPTION
            'Este embaixador não está autorizado a realizar novos cadastros.';
    END IF;


    -- ========================================================
    -- 4. VALIDAR DADOS BÁSICOS
    -- ========================================================

    IF NULLIF(TRIM(p_store_name), '') IS NULL THEN
        RAISE EXCEPTION
            'O nome da empresa / loja é obrigatório.';
    END IF;

    IF NULLIF(TRIM(p_owner_name), '') IS NULL THEN
        RAISE EXCEPTION
            'O nome do responsável é obrigatório.';
    END IF;

    IF NULLIF(TRIM(p_phone), '') IS NULL THEN
        RAISE EXCEPTION
            'O telefone é obrigatório.';
    END IF;

    IF NULLIF(TRIM(p_city), '') IS NULL THEN
        RAISE EXCEPTION
            'A cidade é obrigatória.';
    END IF;

    IF NULLIF(TRIM(p_admin_email), '') IS NULL THEN
        RAISE EXCEPTION
            'O e-mail do administrador é obrigatório.';
    END IF;

    IF p_monthly_fee IS NULL OR p_monthly_fee < 0 THEN
        RAISE EXCEPTION
            'A mensalidade informada é inválida.';
    END IF;


    -- ========================================================
    -- 5. GERAR ID DA LOJA
    -- ========================================================

    v_store_id := 'store-' || substr(
        replace(gen_random_uuid()::text, '-', ''),
        1,
        12
    );


    -- ========================================================
    -- 6. CRIAR LOJA
    -- ========================================================

    INSERT INTO public.stores (
        id,
        code,
        name,
        trade_name,
        nuit_nif,
        city,
        currency,
        is_headquarters,
        valor_mensalidade,
        acesso_ativo
    )
    VALUES (
        v_store_id,
        UPPER('LOJA-' || substr(
            replace(gen_random_uuid()::text, '-', ''),
            1,
            8
        )),
        TRIM(p_store_name),
        TRIM(p_store_name),
        NULLIF(TRIM(p_nuit_nif), ''),
        TRIM(p_city),
        'MT',
        FALSE,
        p_monthly_fee,
        TRUE
    );


    -- ========================================================
    -- 7. CRIAR / ATUALIZAR PERFIL ADMIN
    -- ========================================================

    INSERT INTO public.profiles (
        id,
        email,
        full_name,
        role,
        store_id,
        active
    )
    VALUES (
        v_user_id,
        LOWER(TRIM(p_admin_email)),
        TRIM(p_owner_name),
        'ADMIN',
        v_store_id,
        TRUE
    )
    ON CONFLICT (id)
    DO UPDATE SET
        email = EXCLUDED.email,
        full_name = EXCLUDED.full_name,
        role = 'ADMIN',
        store_id = EXCLUDED.store_id,
        active = TRUE;


    -- ========================================================
    -- 8. REGISTRAR LOJA INDICADA PELO EMBAIXADOR
    -- ========================================================

    v_referred_store_id :=
        replace(gen_random_uuid()::text, '-', '');

    INSERT INTO public.ambassador_referred_stores (
        id,
        ambassador_id,
        name,
        owner_name,
        phone,
        city,
        monthly_fee,
        payment_status,
        contract_duration_months,
        months_active,
        total_commission_earned,
        created_at
    )
    VALUES (
        v_referred_store_id,
        v_ambassador_id,
        TRIM(p_store_name),
        TRIM(p_owner_name),
        TRIM(p_phone),
        TRIM(p_city),
        p_monthly_fee,
        'PENDENTE',
        12,
        0,
        0,
        NOW()
    );


    -- ========================================================
    -- 9. RESULTADO
    -- ========================================================

    RETURN jsonb_build_object(
        'success', true,
        'store_id', v_store_id,
        'ambassador_id', v_ambassador_id,
        'message',
            'Empresa, administrador e indicação do embaixador criados com sucesso.'
    );

END;
$function$

07 | FUNCAO: public.fn_complete_ambassador_onboarding | ASSINATURA: p_referral_code text, p_store_name text, p_owner_name text, p_phone text, p_city text, p_address text, p_nuit_nif text, p_monthly_fee numeric | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_complete_ambassador_onboarding(p_referral_code text, p_store_name text, p_owner_name text, p_phone text, p_city text, p_address text DEFAULT NULL::text, p_nuit_nif text DEFAULT NULL::text, p_monthly_fee numeric DEFAULT 0)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    v_user_id UUID;
    v_user_email TEXT;

    v_ambassador public.ambassadors%ROWTYPE;

    v_store_id TEXT;
    v_store_code TEXT;

    v_commission_rate NUMERIC(5,2);
    v_commission NUMERIC(12,2);

    v_existing_store TEXT;
BEGIN
    -- --------------------------------------------------------
    -- Utilizador autenticado
    -- --------------------------------------------------------

    v_user_id := auth.uid();

    IF v_user_id IS NULL THEN
        RAISE EXCEPTION 'É necessário estar autenticado para concluir a adesão.';
    END IF;


    SELECT email
    INTO v_user_email
    FROM auth.users
    WHERE id = v_user_id;


    IF v_user_email IS NULL THEN
        RAISE EXCEPTION 'Utilizador Auth não encontrado.';
    END IF;


    -- --------------------------------------------------------
    -- Validar embaixador
    -- --------------------------------------------------------

    SELECT *
    INTO v_ambassador
    FROM public.ambassadors
    WHERE UPPER(TRIM(referral_code)) =
          UPPER(TRIM(p_referral_code))
      AND active = TRUE
    LIMIT 1;


    IF v_ambassador.id IS NULL THEN
        RAISE EXCEPTION 'Código de embaixador inválido ou inativo.';
    END IF;


    -- --------------------------------------------------------
    -- Validar dados básicos
    -- --------------------------------------------------------

    IF NULLIF(TRIM(p_store_name), '') IS NULL THEN
        RAISE EXCEPTION 'Nome da loja é obrigatório.';
    END IF;

    IF NULLIF(TRIM(p_owner_name), '') IS NULL THEN
        RAISE EXCEPTION 'Nome do responsável é obrigatório.';
    END IF;

    IF NULLIF(TRIM(p_phone), '') IS NULL THEN
        RAISE EXCEPTION 'Telefone é obrigatório.';
    END IF;

    IF NULLIF(TRIM(p_city), '') IS NULL THEN
        RAISE EXCEPTION 'Cidade é obrigatória.';
    END IF;


    -- --------------------------------------------------------
    -- O mesmo utilizador não pode ser reutilizado para outra
    -- loja através desta adesão.
    -- --------------------------------------------------------

    SELECT store_id
    INTO v_existing_store
    FROM public.profiles
    WHERE id = v_user_id
    LIMIT 1;

    IF v_existing_store IS NOT NULL THEN
        RAISE EXCEPTION 'Este utilizador já está associado a uma loja.';
    END IF;


    -- --------------------------------------------------------
    -- Gerar IDs
    -- --------------------------------------------------------

    v_store_id :=
        'store-ref-' ||
        replace(v_user_id::TEXT, '-', '');

    v_store_code :=
        'REF-' ||
        upper(substr(md5(random()::TEXT || clock_timestamp()::TEXT), 1, 8));


    -- --------------------------------------------------------
    -- Comissão
    -- --------------------------------------------------------

    v_commission_rate :=
        COALESCE(v_ambassador.commission_rate, 15);

    v_commission := 0; -- a comissão é registada a cada pagamento lançado pelo Super Admin


    -- --------------------------------------------------------
    -- Criar loja
    -- --------------------------------------------------------

    INSERT INTO public.stores (
        id,
        code,
        name,
        trade_name,
        nuit_nif,
        city,
        address,
        phone,
        currency,
        language,
        is_headquarters,
        valor_mensalidade,
        data_inicio_teste,
        data_fim_teste,
        acesso_ativo
    )
    VALUES (
        v_store_id,
        v_store_code,
        TRIM(p_store_name),
        TRIM(p_store_name),
        NULLIF(TRIM(p_nuit_nif), ''),
        TRIM(p_city),
        NULLIF(TRIM(p_address), ''),
        TRIM(p_phone),
        'MZN',
        'pt-MZ',
        FALSE,
        COALESCE(p_monthly_fee, 0),
        CURRENT_DATE,
        CURRENT_DATE + 30,
        TRUE
    );


    -- --------------------------------------------------------
    -- Transformar utilizador atual em ADMIN
    -- --------------------------------------------------------

    UPDATE public.profiles
    SET
        email = v_user_email,
        full_name = TRIM(p_owner_name),
        role = 'ADMIN',
        store_id = v_store_id,
        active = TRUE,
        updated_at = NOW()
    WHERE id = v_user_id;


    IF NOT FOUND THEN
        INSERT INTO public.profiles (
            id,
            email,
            full_name,
            role,
            store_id,
            active
        )
        VALUES (
            v_user_id,
            v_user_email,
            TRIM(p_owner_name),
            'ADMIN',
            v_store_id,
            TRUE
        );
    END IF;


    -- --------------------------------------------------------
    -- Registrar indicação do embaixador
    -- --------------------------------------------------------

    INSERT INTO public.ambassador_referred_stores (
        id,
        store_id,
        ambassador_id,
        name,
        owner_name,
        phone,
        city,
        monthly_fee,
        payment_status,
        commission_rate,
        contract_duration_months,
        total_commission_earned
    )
    VALUES (
        v_store_id,
        v_store_id,
        v_ambassador.id,
        TRIM(p_store_name),
        TRIM(p_owner_name),
        TRIM(p_phone),
        TRIM(p_city),
        COALESCE(p_monthly_fee, 0),
        'PENDENTE',
        v_commission_rate,
        12,
        v_commission
    );


    -- --------------------------------------------------------
    -- Atualizar comissão pendente do embaixador
    -- --------------------------------------------------------

    IF v_commission > 0 THEN

        UPDATE public.ambassadors
        SET pending_commissions =
            COALESCE(pending_commissions, 0)
            + v_commission
        WHERE id = v_ambassador.id;

    END IF;


    -- --------------------------------------------------------
    -- Resultado
    -- --------------------------------------------------------

    RETURN jsonb_build_object(
        'success', TRUE,
        'store_id', v_store_id,
        'store_code', v_store_code,
        'ambassador_id', v_ambassador.id,
        'ambassador_name', v_ambassador.name,
        'commission_rate', v_commission_rate,
        'commission', v_commission,
        'admin_user_id', v_user_id,
        'admin_email', v_user_email
    );

EXCEPTION
    WHEN unique_violation THEN
        RAISE EXCEPTION 'Não foi possível concluir a adesão porque alguns dados já existem.';
END;
$function$

07 | FUNCAO: public.fn_complete_ambassador_onboarding | ASSINATURA: p_referral_code text, p_store_name text, p_owner_name text, p_phone text, p_city text, p_monthly_fee numeric | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_complete_ambassador_onboarding(p_referral_code text, p_store_name text, p_owner_name text, p_phone text, p_city text, p_monthly_fee numeric)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
    v_user_id UUID;
    v_ambassador public.ambassadors%ROWTYPE;
    v_store_id TEXT;
    v_store_code TEXT;
    v_referral_id TEXT;
BEGIN
    -- =====================================================
    -- UTILIZADOR AUTENTICADO
    -- =====================================================

    v_user_id := auth.uid();

    IF v_user_id IS NULL THEN
        RAISE EXCEPTION 'Utilizador não autenticado.';
    END IF;


    -- =====================================================
    -- VALIDAR EMBAIXADOR
    -- =====================================================

    SELECT *
    INTO v_ambassador
    FROM public.ambassadors
    WHERE referral_code = TRIM(p_referral_code)
    LIMIT 1;

    IF v_ambassador.id IS NULL THEN
        RAISE EXCEPTION 'Código de embaixador inválido.';
    END IF;

    IF COALESCE(v_ambassador.status, 'ATIVO') <> 'ATIVO'
       OR COALESCE(v_ambassador.active, FALSE) = FALSE THEN

        RAISE EXCEPTION 'Este embaixador não está ativo para novos cadastros.';
    END IF;


    -- =====================================================
    -- VALIDAR DADOS
    -- =====================================================

    IF NULLIF(TRIM(p_store_name), '') IS NULL THEN
        RAISE EXCEPTION 'O nome da loja é obrigatório.';
    END IF;

    IF NULLIF(TRIM(p_owner_name), '') IS NULL THEN
        RAISE EXCEPTION 'O nome do responsável é obrigatório.';
    END IF;

    IF NULLIF(TRIM(p_phone), '') IS NULL THEN
        RAISE EXCEPTION 'O telefone é obrigatório.';
    END IF;

    IF NULLIF(TRIM(p_city), '') IS NULL THEN
        RAISE EXCEPTION 'A cidade é obrigatória.';
    END IF;

    IF COALESCE(p_monthly_fee, 0) <= 0 THEN
        RAISE EXCEPTION 'A mensalidade deve ser maior que zero.';
    END IF;


    -- =====================================================
    -- GERAR IDS
    -- =====================================================

    v_store_id :=
        'store-' ||
        substring(
            replace(gen_random_uuid()::text, '-', '')
            from 1 for 16
        );

    v_store_code :=
        'GEF-' ||
        upper(
            substring(
                replace(gen_random_uuid()::text, '-', '')
                from 1 for 8
            )
        );

    v_referral_id :=
        'store-ref-' ||
        substring(
            replace(gen_random_uuid()::text, '-', '')
            from 1 for 16
        );


    -- =====================================================
    -- CRIAR A LOJA
    -- IMPORTANTE:
    -- A LOJA FICA BLOQUEADA ATÉ APROVAÇÃO DO SUPERADMIN
    -- =====================================================

    INSERT INTO public.stores (
        id,
        code,
        name,
        trade_name,
        city,
        currency,
        is_headquarters,
        valor_mensalidade,
        acesso_ativo,
        motivo_bloqueio
    )
    VALUES (
        v_store_id,
        v_store_code,
        TRIM(p_store_name),
        TRIM(p_store_name),
        TRIM(p_city),
        'MT',
        FALSE,
        p_monthly_fee,
        FALSE,
        'Cadastro indicado por embaixador aguardando aprovação do Superadmin.'
    );


    -- =====================================================
    -- CRIAR PERFIL ADMIN DA LOJA
    -- =====================================================

    INSERT INTO public.profiles (
        id,
        full_name,
        role,
        store_id,
        active
    )
    VALUES (
        v_user_id,
        TRIM(p_owner_name),
        'ADMIN',
        v_store_id,
        TRUE
    )
    ON CONFLICT (id)
    DO UPDATE SET
        full_name = EXCLUDED.full_name,
        role = 'ADMIN',
        store_id = v_store_id,
        active = TRUE;


    -- =====================================================
    -- REGISTAR INDICAÇÃO
    -- =====================================================

    INSERT INTO public.ambassador_referred_stores (
        id,
        ambassador_id,
        store_id,
        name,
        owner_name,
        phone,
        city,
        monthly_fee,
        payment_status,
        commission_rate,
        contract_duration_months,
        months_active,
        total_commission_earned,
        registration_status
    )
    VALUES (
        v_referral_id,
        v_ambassador.id,
        v_store_id,
        TRIM(p_store_name),
        TRIM(p_owner_name),
        TRIM(p_phone),
        TRIM(p_city),
        p_monthly_fee,
        'PENDENTE',
        COALESCE(v_ambassador.commission_rate, 15),
        12,
        0,
        0,
        'PENDENTE'
    );


    -- =====================================================
    -- RESULTADO
    -- =====================================================

    RETURN jsonb_build_object(
        'success', TRUE,
        'store_id', v_store_id,
        'store_code', v_store_code,
        'ambassador_id', v_ambassador.id,
        'registration_status', 'PENDENTE',
        'payment_status', 'PENDENTE',
        'message',
            'Cadastro recebido com sucesso. A loja está aguardando aprovação do Superadmin.'
    );

END;
$function$

07 | FUNCAO: public.fn_confirm_purchase | ASSINATURA: p_store_id text, p_supplier_id text, p_supplier_name text, p_invoice_number text, p_destination_location text, p_items jsonb, p_operator_id uuid, p_notes text | RETORNA: purchases | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_confirm_purchase(p_store_id text, p_supplier_id text, p_supplier_name text, p_invoice_number text, p_destination_location text, p_items jsonb, p_operator_id uuid, p_notes text DEFAULT NULL::text)
 RETURNS purchases
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    v_purchase public.purchases;
    v_purchase_id TEXT;
    v_item JSONB;
    v_product RECORD;
    v_qty NUMERIC;
    v_total_cost NUMERIC := 0;
    v_new_stock NUMERIC;
    v_new_cost NUMERIC;
    v_batch_id TEXT;
    v_destination TEXT;
BEGIN

    p_operator_id := auth.uid();

    PERFORM public.fn_assert_store_access(
        p_store_id,
        ARRAY['ADMIN','GERENTE','ESTOQUISTA']
    );


    v_destination :=
        COALESCE(
            p_destination_location,
            'ARMAZEM'
        );


    IF v_destination NOT IN (
        'LOJA',
        'ARMAZEM',
        'PATIO'
    )
    THEN
        RAISE EXCEPTION
            'Localização de destino inválida.';
    END IF;


    v_purchase_id :=
        'purch-'
        || EXTRACT(EPOCH FROM clock_timestamp())::BIGINT
        || '-'
        || FLOOR(RANDOM() * 9000 + 1000)::TEXT;


    FOR v_item IN
        SELECT *
        FROM jsonb_array_elements(p_items)
    LOOP

        v_total_cost :=
            v_total_cost
            +
            (
                (v_item->>'quantityPurchased')::NUMERIC
                *
                COALESCE(
                    (v_item->>'unitCost')::NUMERIC,
                    0
                )
            );

    END LOOP;


    INSERT INTO public.purchases (
        id,
        store_id,
        supplier_id,
        supplier_name,
        invoice_number,
        destination_location,
        total_cost,
        notes,
        operator_id
    )
    VALUES (
        v_purchase_id,
        p_store_id,
        p_supplier_id,
        p_supplier_name,
        p_invoice_number,
        v_destination,
        v_total_cost,
        p_notes,
        p_operator_id
    )
    RETURNING *
    INTO v_purchase;


    FOR v_item IN
        SELECT *
        FROM jsonb_array_elements(p_items)
    LOOP

        SELECT *
        INTO v_product
        FROM public.products
        WHERE id = (v_item->>'productId')
          AND store_id = p_store_id
        FOR UPDATE;


        IF NOT FOUND THEN
            RAISE EXCEPTION
                'Produto não encontrado: %',
                (v_item->>'productId');
        END IF;


        v_qty :=
            (v_item->>'quantityPurchased')::NUMERIC;


        IF v_qty <= 0 THEN
            RAISE EXCEPTION
                'Quantidade de compra inválida.';
        END IF;


        v_new_stock :=
            v_product.current_stock + v_qty;


        IF (v_item->>'unitCost') IS NOT NULL
           AND (v_item->>'unitCost')::NUMERIC > 0
           AND v_new_stock > 0
        THEN

            v_new_cost :=
                (
                    (
                        v_product.current_stock
                        * v_product.cost_price
                    )
                    +
                    (
                        v_qty
                        * (v_item->>'unitCost')::NUMERIC
                    )
                )
                / v_new_stock;

        ELSE

            v_new_cost :=
                v_product.cost_price;

        END IF;


        UPDATE public.products
        SET
            current_stock = v_new_stock,
            cost_price = v_new_cost,
            sale_price =
                COALESCE(
                    (v_item->>'newSalePrice')::NUMERIC,
                    sale_price
                ),
            stock_loja =
                CASE
                    WHEN v_destination = 'LOJA'
                        THEN stock_loja + v_qty
                    ELSE stock_loja
                END,
            stock_armazem =
                CASE
                    WHEN v_destination = 'ARMAZEM'
                        THEN stock_armazem + v_qty
                    ELSE stock_armazem
                END,
            stock_patio =
                CASE
                    WHEN v_destination = 'PATIO'
                        THEN stock_patio + v_qty
                    ELSE stock_patio
                END,
            updated_at = NOW()
        WHERE id = v_product.id
          AND store_id = p_store_id;


        INSERT INTO public.purchase_items (
            purchase_id,
            product_id,
            quantity_purchased,
            unit_cost,
            new_sale_price,
            batch_number,
            expiry_date
        )
        VALUES (
            v_purchase_id,
            v_product.id,
            v_qty,
            COALESCE(
                (v_item->>'unitCost')::NUMERIC,
                0
            ),
            (v_item->>'newSalePrice')::NUMERIC,
            v_item->>'batchNumber',
            (v_item->>'expiryDate')::DATE
        );


        v_batch_id := NULL;


        IF v_item->>'batchNumber' IS NOT NULL
           AND TRIM(v_item->>'batchNumber') <> ''
        THEN

            v_batch_id :=
                'batch-' || gen_random_uuid()::TEXT;


            INSERT INTO public.batches (
                id,
                store_id,
                product_id,
                batch_number,
                supplier_id,
                initial_quantity_base,
                current_quantity_base,
                cost_per_base,
                expiry_date,
                status
            )
            VALUES (
                v_batch_id,
                p_store_id,
                v_product.id,
                v_item->>'batchNumber',
                p_supplier_id,
                v_qty,
                v_qty,
                COALESCE(
                    (v_item->>'unitCost')::NUMERIC,
                    v_new_cost
                ),
                (v_item->>'expiryDate')::DATE,
                'ACTIVE'
            );

        END IF;


        INSERT INTO public.stock_movements (
            id,
            store_id,
            product_id,
            batch_id,
            movement_type,
            quantity_base,
            location,
            reference_type,
            reference_id,
            operator_id
        )
        VALUES (
            'mov-' || gen_random_uuid()::TEXT,
            p_store_id,
            v_product.id,
            v_batch_id,
            'ENTRADA_COMPRA',
            v_qty,
            v_destination,
            'purchases',
            v_purchase_id,
            p_operator_id
        );

    END LOOP;


    INSERT INTO public.audit_logs (
        id,
        store_id,
        action,
        entity,
        entity_id,
        details,
        operator_id
    )
    VALUES (
        'audit-' || gen_random_uuid()::TEXT,
        p_store_id,
        'ENTRADA_COMPRA',
        'purchases',
        v_purchase_id,
        'Compra NF '
        || COALESCE(p_invoice_number, '-')
        || ' de '
        || COALESCE(p_supplier_name, '-')
        || ' total '
        || v_total_cost,
        p_operator_id
    );


    RETURN v_purchase;

END;
$function$

07 | FUNCAO: public.fn_get_public_ambassador_dashboard | ASSINATURA: p_referral_code text | RETORNA: jsonb | LINGUAGEM: sql | SECURITY DEFINER: true | VOLATILIDADE: s | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_get_public_ambassador_dashboard(p_referral_code text)
 RETURNS jsonb
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
    SELECT COALESCE(
        (SELECT jsonb_build_object(
                    'valid', TRUE,
                    'ambassador', jsonb_build_object(
                        'name', a.name,
                        'referral_code', a.referral_code,
                        'status', COALESCE(a.status, CASE WHEN a.active THEN 'ATIVO' ELSE 'DESATIVADO' END)
                    ),
                    'stores', '[]'::JSONB
                )
           FROM public.ambassadors a
          WHERE UPPER(TRIM(a.referral_code)) = UPPER(TRIM(p_referral_code))
          LIMIT 1),
        jsonb_build_object('valid', FALSE, 'message', 'Este link de embaixador não é válido.')
    );
$function$

07 | FUNCAO: public.fn_get_public_ambassador_stores | ASSINATURA: p_code text | RETORNA: jsonb | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_get_public_ambassador_stores(p_code text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
    v_ambassador_id TEXT;
BEGIN

    SELECT id
    INTO v_ambassador_id
    FROM public.ambassadors
    WHERE referral_code = TRIM(p_code)
    LIMIT 1;

    IF v_ambassador_id IS NULL THEN
        RETURN '[]'::jsonb;
    END IF;

    RETURN COALESCE(
        (
            SELECT jsonb_agg(
                jsonb_build_object(
                    'name', ars.name,
                    'city', ars.city,
                    'created_at', ars.created_at
                )
                ORDER BY ars.created_at DESC
            )
            FROM public.ambassador_referred_stores ars
            WHERE ars.ambassador_id = v_ambassador_id
        ),
        '[]'::jsonb
    );

END;
$function$

07 | FUNCAO: public.fn_internal_create_store_user | ASSINATURA: p_email text, p_password text, p_full_name text, p_role text, p_store_id text | RETORNA: uuid | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: v | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_internal_create_store_user(p_email text, p_password text, p_full_name text, p_role text, p_store_id text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'extensions', 'auth', 'pg_temp'
AS $function$
DECLARE
    v_uid UUID := gen_random_uuid();
    v_email TEXT := LOWER(TRIM(p_email));
BEGIN
    IF v_email !~ '^[^@\s]+@[^@\s]+\.[^@\s]+$' THEN
        RAISE EXCEPTION 'Email inválido: %', p_email;
    END IF;
    IF p_password IS NULL OR LENGTH(p_password) < 8 THEN
        RAISE EXCEPTION 'A palavra-passe deve ter pelo menos 8 caracteres.';
    END IF;
    IF p_role NOT IN ('ADMIN', 'GERENTE', 'CASHIER', 'ESTOQUISTA', 'EMBAIXADOR') THEN
        RAISE EXCEPTION 'Função inválida para utilizador de loja: %', p_role;
    END IF;
    IF EXISTS (SELECT 1 FROM auth.users WHERE LOWER(email) = v_email) THEN
        RAISE EXCEPTION 'Já existe um utilizador com o email %.', v_email;
    END IF;

    INSERT INTO auth.users (
        instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
        raw_app_meta_data, raw_user_meta_data, created_at, updated_at,
        confirmation_token, email_change, email_change_token_new, recovery_token
    ) VALUES (
        '00000000-0000-0000-0000-000000000000', v_uid, 'authenticated', 'authenticated',
        v_email, crypt(p_password, gen_salt('bf')), NOW(),
        '{"provider":"email","providers":["email"]}'::JSONB,
        jsonb_build_object('full_name', TRIM(p_full_name)),
        NOW(), NOW(), '', '', '', ''
    );

    INSERT INTO auth.identities (
        id, user_id, provider_id, identity_data, provider, last_sign_in_at, created_at, updated_at
    ) VALUES (
        gen_random_uuid(), v_uid, v_uid::TEXT,
        jsonb_build_object('sub', v_uid::TEXT, 'email', v_email, 'email_verified', TRUE),
        'email', NOW(), NOW(), NOW()
    );

    -- O trigger handle_new_user já criou o perfil (CASHIER, inativo, sem loja): ajusta.
    UPDATE public.profiles
       SET email = v_email,
           full_name = TRIM(p_full_name),
           role = p_role,
           store_id = p_store_id,
           active = TRUE,
           updated_at = NOW()
     WHERE id = v_uid;

    IF NOT FOUND THEN
        INSERT INTO public.profiles (id, email, full_name, role, store_id, active)
        VALUES (v_uid, v_email, TRIM(p_full_name), p_role, p_store_id, TRUE);
    END IF;

    RETURN v_uid;
END;
$function$

07 | FUNCAO: public.fn_is_store_unlocked | ASSINATURA: check_store_id text | RETORNA: boolean | LINGUAGEM: plpgsql | SECURITY DEFINER: true | VOLATILIDADE: s | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_is_store_unlocked(check_store_id text)
 RETURNS boolean
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    store_record RECORD;
BEGIN
    SELECT acesso_ativo, data_fim_teste
    INTO store_record
    FROM public.stores
    WHERE id = check_store_id;

    IF NOT FOUND THEN
        RETURN FALSE;
    END IF;

    IF COALESCE(store_record.acesso_ativo, FALSE) = FALSE THEN
        RETURN FALSE;
    END IF;

    IF store_record.data_fim_teste < CURRENT_DATE THEN
        RETURN FALSE;
    END IF;

    RETURN TRUE;
END;
$function$

07 | FUNCAO: public.fn_is_superadmin | ASSINATURA:  | RETORNA: boolean | LINGUAGEM: sql | SECURITY DEFINER: true | VOLATILIDADE: s | DEFINICAO: CREATE OR REPLACE FUNCTION public.fn_is_superadmin()
